@page "/"
@using SeleneFrontend.Components
@using SeleneFrontend.Services
@implements IDisposable
@inject MissionConfigState missionState
@inject UiService Ui
@inject NavigationManager Nav

<PageTitle>SELENE OPS · When can a lander survive at the lunar south pole?</PageTitle>

<div class="app-container @(Ui.AnalystMode ? "mode-analyst" : "mode-simple") @(Ui.Landed ? "is-landed" : "")">
    <TopBar />
    @if (missionState.LoadError is { } err)
    {
        <div class="load-error" role="alert">
            Data could not be loaded: @err.
            <button type="button" class="btn-secondary small" @onclick="Reload">Reload</button>
        </div>
    }
    <div class="main-content">
        <div class="moon-panel">
            <MoonPanel />
        </div>
        @if (Ui.AnalystMode)
        {
            <div class="splitter" aria-hidden="true"></div>
        }
        <div class="config-panel">
            <ConfigPanel />
        </div>
    </div>
    @if (Ui.AnalystMode)
    {
        <ResultsStrip />
    }
    <AppFooter />
</div>

@if (Ui.BootVisible)
{
    <BootSequence />
}
<HelpDialog />
<CreditsDialog />

@code {
    protected override void OnInitialized()
    {
        Ui.OnChanged += Refresh;
        missionState.OnStateChanged += Refresh;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Ui.StartupAsync();
    }

    private void Reload() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Ui.OnChanged -= Refresh;
        missionState.OnStateChanged -= Refresh;
    }
}

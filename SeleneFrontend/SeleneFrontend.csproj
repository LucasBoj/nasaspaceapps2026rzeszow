<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- All UI formatting is invariant and all times are UTC: skip ICU culture data (smaller first download).
         InvariantTimezone would also help but needs the wasm-tools workload. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Publish: pre-compressed .gz/.br next to every asset (served by nginx gzip_static). -->
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <!-- Trimming (Blazor default) verified safe: JSON models, JS-interop DTOs and analysis all work
         on the published build (deploy/README.md → test checklist). -->
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Original (unoptimised, ~64 MB) lander models: input of tools/optimize-models only. Never built,
         served or published; git-ignored. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\models\source\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The local Cesium ion token lives in this git-ignored file. Never ship it: published files are public. -->
  <ItemGroup>
    <Content Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

</Project>

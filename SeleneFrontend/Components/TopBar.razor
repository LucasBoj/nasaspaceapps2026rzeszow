@using System.Globalization
@using SeleneFrontend.Services
@implements IDisposable
@inject UiService Ui
@inject MissionConfigState MissionState
@inject AnalysisService Analysis

<header class="top-bar">
    <div class="top-bar-left">
        <div class="app-title">
            <h1>SELENE OPS</h1>
            <p>Find when and where a lunar lander can survive at the Moon's south pole</p>
        </div>
        <button type="button" class="btn-primary quick-demo top" disabled="@(!MissionState.IsLoaded)"
                title="Pick the recommended site and lander, land and show the verdict" @onclick="Ui.QuickDemoAsync">
            @(MissionState.IsLoaded ? "▶ Quick demo" : "Loading data…")
        </button>
    </div>

    <div class="top-bar-right">
        @if (Ui.AnalystMode)
        {
            <div class="status-indicators">
                <div class="status-item" title="Precomputed site, lander and illumination data">
                    <span class="status-dot @DataDot"></span>
                    <span>DATA: @DataText</span>
                </div>
                @if (Ui.ViewMode is { } mode)
                {
                    <div class="status-item" title="Moon view">
                        <span class="status-dot ok"></span>
                        <span>@mode</span>
                    </div>
                }
            </div>
            <div class="utc-clock" aria-label="Current UTC time">
                <span class="utc-time">@utcTime</span>
            </div>
        }
        else
        {
            <span class="status-dot solo @DataDot" role="img" tabindex="0"
                  aria-label="@($"Data {DataText.ToLowerInvariant()}{(Ui.ViewMode is { } v ? $", {v.ToLowerInvariant()}" : "")}")"
                  title="@($"Data {DataText.ToLowerInvariant()}{(Ui.ViewMode is { } v2 ? $" · {v2.ToLowerInvariant()}" : "")}")"></span>
        }
        <label class="analyst-toggle" title="Show the timeline, heatmap, comparison, specs and every number">
            <input type="checkbox" role="switch" aria-label="Analyst mode" checked="@Ui.AnalystMode" aria-checked="@(Ui.AnalystMode ? "true" : "false")"
                   @onchange="@((ChangeEventArgs e) => Ui.SetAnalystMode(e.Value is true))" />
            <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
            <span>Analyst mode</span>
        </label>
        <button type="button" class="help-btn" aria-label="What is this? Show the welcome card" title="What is this?" @onclick="Ui.ShowWelcome">?</button>
    </div>
</header>

@code {
    private string utcTime = "";
    private PeriodicTimer? timer;
    private CancellationTokenSource cts = new();

    private string DataText => MissionState.LoadError is not null ? "ERROR" : MissionState.IsLoaded ? "READY" : "LOADING";
    private string DataDot => MissionState.LoadError is not null ? "error" : MissionState.IsLoaded ? "ok" : "warn";

    protected override void OnInitialized()
    {
        UpdateTime();
        Ui.OnChanged += Refresh;
        MissionState.OnStateChanged += Refresh;
        Analysis.OnChanged += Refresh;
        _ = TickAsync();
    }

    private async Task TickAsync()
    {
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                UpdateTime();
                if (Ui.AnalystMode) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void UpdateTime() =>
        utcTime = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss'Z'", CultureInfo.InvariantCulture);

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        cts.Cancel();
        timer?.Dispose();
        Ui.OnChanged -= Refresh;
        MissionState.OnStateChanged -= Refresh;
        Analysis.OnChanged -= Refresh;
    }
}

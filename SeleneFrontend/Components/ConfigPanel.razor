@using System.Globalization
@using SeleneFrontend.Models
@using SeleneFrontend.Services
@inject MissionConfigState MissionState
@inject AnalysisService Analysis
@inject UiService Ui
@inject IlluminationRepository Repo
@implements IDisposable

<div class="config-panel-content">
    <ol class="steps" aria-label="Plan a landing in three steps">
        @* ---------------------------------------------------------------- 1 site *@
        <li class="step-item @StepState(1)" id="step-1">
            <h2 class="step-head">
                <button type="button" aria-expanded="@(open == 1 ? "true" : "false")" aria-controls="step-body-1" @onclick="() => Toggle(1)">
                    <span class="step-num" aria-hidden="true">@(Done(1) && open != 1 ? "✓" : "1")</span>
                    <span class="step-title">Choose a site</span>
                    @if (open != 1 && MissionState.SelectedSite is { } cur)
                    {
                        <span class="step-value">@cur.Name</span>
                    }
                </button>
            </h2>
            @if (open == 1)
            {
                <div class="step-body" id="step-body-1">
                    @if (Ui.Landed)
                    {
                        <p class="step-note" role="status">Landed at @MissionState.SelectedSite?.Name. Start a new landing to change the site.</p>
                        <button type="button" class="btn-secondary small" @onclick="Ui.NewLanding">New landing</button>
                    }
                    <div class="site-list" role="radiogroup" aria-label="Landing sites">
                        @foreach (var site in MissionState.AvailableSites)
                        {
                            var selected = MissionState.SelectedSite?.Id == site.Id;
                            var info = IndexFor(site.Id);
                            <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")"
                                    class="site-row @(selected ? "selected" : "")" disabled="@Ui.Landed"
                                    @onclick="() => OnSiteSelected(site.Id)">
                                <span class="site-row-name">@site.Name</span>
                                @if (info is not null)
                                {
                                    <span class="site-row-fact">sunlit <span class="num">@Pct0(info.PctSunlit)</span> of the time</span>
                                }
                            </button>
                        }
                    </div>
                    @if (UiService.IsCustom(MissionState.SelectedSite) && MissionState.SelectedSite is { } custom)
                    {
                        <div class="reason custom-reason" role="status">
                            <p>Custom points can't be analysed yet — our sunlight data is precomputed for the 9 Artemis regions
                                (you clicked <span class="num">@Coords(custom)</span>). Pick a region, or click ‘Nearest region’.</p>
                            @if (Ui.NearestRegion(custom) is { } near)
                            {
                                <button type="button" class="btn-secondary small nearest-region" @onclick="Ui.SelectNearestRegionAsync">Nearest region: @near.Name</button>
                            }
                        </div>
                    }
                    @if (Ui.AnalystMode && MissionState.SelectedSite is { } sel)
                    {
                        <div class="site-info">
                            <p class="num">@Coords(sel)</p>
                            @if (sel.Approximate)
                            {
                                <p class="site-source warn">positions approximate — verify</p>
                            }
                            else if (sel is { CandidateId: { } cid })
                            {
                                <p class="site-source">site @cid · best of @sel.CandidatesEvaluated published candidates ·
                                    <a href="https://doi.org/10.1029/2025JE009434" target="_blank" rel="noopener">Wueller et al. 2026</a></p>
                            }
                            @if (MissionState.NasaCheckFor(sel.Id) is { } check && MissionState.NasaCheck is { } nasa)
                            {
                                <p class="site-source nasa-check">
                                    <Term Key="nasacheck">Sunlit time</Term> (18.6-yr avg, any sunlight):
                                    NASA LOLA map @Pct(check.NasaSunPct) · our model @Pct(check.OursSunPct18y)
                                    (@Delta(check.DeltaSunPct))@if (!double.IsNaN(check.NasaSunMinNearPct))
                                    {
                                        <text> · NASA within ±120 m: @Pct(check.NasaSunMinNearPct)–@Pct(check.NasaSunMaxNearPct)</text>
                                    } ·
                                    <a href="@nasa.Url" target="_blank" rel="noopener">Mazarico et al. 2011</a>
                                </p>
                            }
                            <button class="btn-secondary small" disabled="@(!MissionState.CanFlyTo)" aria-describedby="@(MissionState.CanFlyTo ? null : "flyto-reason")" @onclick="MissionState.RequestFlyTo">Fly to</button>
                            @if (!MissionState.CanFlyTo)
                            {
                                <p class="reason" id="flyto-reason">Fly to works for the 9 regions — use Zoom to site for a custom point.</p>
                            }
                        </div>
                    }
                    <button type="button" class="btn-secondary small step-next" disabled="@(MissionState.SelectedSite is null)"
                            aria-describedby="@(MissionState.SelectedSite is null ? "next1-reason" : null)" @onclick="() => Open(2)">Next: choose a lander</button>
                    @if (MissionState.SelectedSite is null)
                    {
                        <p class="reason" id="next1-reason">Choose a site above (or click a pin on the Moon) first.</p>
                    }
                </div>
            }
        </li>

        @* ---------------------------------------------------------------- 2 lander *@
        <li class="step-item @StepState(2)" id="step-2">
            <h2 class="step-head">
                <button type="button" aria-expanded="@(open == 2 ? "true" : "false")" aria-controls="step-body-2" @onclick="() => Toggle(2)">
                    <span class="step-num" aria-hidden="true">@(Done(2) && open != 2 ? "✓" : "2")</span>
                    <span class="step-title">Choose a lander</span>
                    @if (open != 2 && MissionState.SelectedLander is { } l)
                    {
                        <span class="step-value">@l.Name</span>
                    }
                </button>
            </h2>
            @if (open == 2)
            {
                <div class="step-body" id="step-body-2">
                    <LanderPicker />
                    <button type="button" class="btn-secondary small step-next" disabled="@(MissionState.SelectedLander is null)"
                            aria-describedby="@(MissionState.SelectedLander is null ? "next2-reason" : null)" @onclick="() => Open(3)">Next: run the analysis</button>
                    @if (MissionState.SelectedLander is null)
                    {
                        <p class="reason" id="next2-reason">Choose a lander card above first.</p>
                    }
                </div>
            }
        </li>

        @* ---------------------------------------------------------------- 3 run *@
        <li class="step-item @StepState(3)" id="step-3">
            <h2 class="step-head">
                <button type="button" aria-expanded="@(open == 3 ? "true" : "false")" aria-controls="step-body-3" @onclick="() => Toggle(3)">
                    <span class="step-num" aria-hidden="true">@(Done(3) && open != 3 ? "✓" : "3")</span>
                    <span class="step-title">Run analysis</span>
                    @if (open != 3)
                    {
                        <span class="step-value">@VerdictText.Days(MissionState.MissionDurationDays) on the surface</span>
                    }
                </button>
            </h2>
            @if (open == 3)
            {
                <div class="step-body" id="step-body-3">
                    <p class="step-summary">
                        Stay <strong>@VerdictText.Days(MissionState.MissionDurationDays)</strong> on the surface, landing on the best day
                        between <span class="num">@ShortDate(MissionState.WindowStart)</span> and <span class="num">@ShortDate(MissionState.WindowEnd)</span>.
                    </p>
                    <details class="change-dates" open="@Ui.AnalystMode">
                        <summary>Change dates</summary>
                        <div class="change-dates-body">
                            <div class="field">
                                <label for="win-start">Earliest landing date (UTC)</label>
                                <input id="win-start" @key="@($"ws-{MissionState.WindowRevision}")" type="date" value="@Day(MissionState.WindowStart)" min="@Day(MissionState.DataStart)" max="@Day(MissionState.DataEnd)"
                                       @onchange="@((ChangeEventArgs e) => OnStartDateChanged(e.Value?.ToString() ?? ""))" />
                            </div>
                            <div class="field">
                                <label for="win-end">Latest landing date (UTC)</label>
                                <input id="win-end" @key="@($"we-{MissionState.WindowRevision}")" type="date" value="@Day(MissionState.WindowEnd)" min="@Day(MissionState.DataStart)" max="@Day(MissionState.DataEnd)"
                                       @onchange="@((ChangeEventArgs e) => OnEndDateChanged(e.Value?.ToString() ?? ""))" />
                                @if (MissionState.WindowNotice is { } notice)
                                {
                                    <small class="window-notice" role="status">Dates adjusted — @notice</small>
                                }
                                else if (!string.IsNullOrEmpty(MissionState.DataRangeText))
                                {
                                    <small class="window-hint">@MissionState.DataRangeText</small>
                                }
                            </div>
                            <div class="field">
                                <label for="mission-days">Days on the surface (Earth days)</label>
                                <input id="mission-days" type="number" min="0" step="any" value="@Inv(MissionState.MissionDurationDays)" @onchange="@((ChangeEventArgs e) => OnDurationChanged(e.Value?.ToString() ?? ""))" />
                            </div>
                            @if (Ui.AnalystMode)
                            {
                                <p class="window-hint">Data step: 1 h (precomputed hourly, 2027–2028)</p>
                            }
                        </div>
                    </details>

                    @if (Ui.AnalystMode)
                    {
                        <div class="constraints" role="group" aria-labelledby="constraints-title">
                            <h3 id="constraints-title">Constraints</h3>
                            <div class="field">
                                <div class="label-row">
                                    <label for="min-comms">Min Earth visibility [% of hours]</label>
                                    <Term Key="earth" AriaLabel="What is Earth visibility?">?</Term>
                                </div>
                                <input id="min-comms" type="number" min="0" max="100" value="@Inv(MissionState.MinCommsPercent)" @onchange="@((ChangeEventArgs e) => OnMinCommsChanged(e.Value?.ToString() ?? ""))" />
                            </div>
                            <div class="field">
                                <div class="label-row">
                                    <label for="min-battery">Min battery SoC [%]</label>
                                    <Term Key="soc" AriaLabel="What is SoC?">?</Term>
                                </div>
                                <input id="min-battery" type="number" min="0" max="100" value="@Inv(MissionState.MinBatteryPercent)" @onchange="@((ChangeEventArgs e) => OnMinBatteryChanged(e.Value?.ToString() ?? ""))" />
                            </div>
                        </div>
                    }
                </div>
            }
        </li>
    </ol>

    <div class="panel-actions">
        @{ var blockers = Ui.LandBlockers(); var outdated = Analysis.IsOutdated && Ui.VerdictRequested; }
        <button type="button" class="btn-primary confirm-landing run-main" disabled="@(!Ui.CanConfirmLanding)"
                aria-describedby="@(blockers.Count > 0 ? "run-blockers" : null)"
                @onclick="() => Ui.ConfirmLandingAsync()">
            @(Ui.LandingInProgress ? "Landing…" : outdated ? "Update results" : Analysis.IsRunning && Ui.VerdictRequested ? $"Analyzing… {Analysis.Progress * 100:0}%" : "Land & analyze")
        </button>
        @if (blockers.Count > 0)
        {
            <p class="reason blockers" id="run-blockers" role="status">
                <span>To continue:</span>
                @foreach (var (b, i) in blockers.Select((b, i) => (b, i)))
                {
                    @if (i > 0) { <span aria-hidden="true"> · </span> }
                    @if (b.Step > 0)
                    {
                        var step = b.Step;
                        <button type="button" class="link-btn" @onclick="() => GoToStep(step)">@Circled(step) @b.Text</button>
                    }
                    else
                    {
                        <span>@b.Text</span>
                    }
                    @if (b.NearestRegion && Ui.NearestRegion(MissionState.SelectedSite) is { } near)
                    {
                        <span aria-hidden="true"> · </span>
                        <button type="button" class="link-btn nearest-region" @onclick="Ui.SelectNearestRegionAsync">Nearest region: @near.Name</button>
                    }
                }
            </p>
        }
        @if (Ui.AnalystMode)
        {
            <div class="config-actions">
                <button class="btn-secondary small rerun" disabled="@(!Analysis.CanRun)" aria-describedby="@(Analysis.CanRun ? null : "rerun-reason")"
                        title="Simulate every landing day for all 9 sites again, without the landing animation (e.g. after what-if or date changes)"
                        @onclick="Ui.RunAnalysisAsync">Re-run analysis</button>
                <button class="btn-secondary small" @onclick="@(() => MissionState.Reset())">Reset</button>
            </div>
            @if (Analysis.CannotRunReason is { } why)
            {
                <p class="reason" id="rerun-reason">Re-run needs you to @why.</p>
            }
        }
    </div>
</div>

@code {
    // type=number inputs need invariant formatting; the browser culture (pl) would render "6,5".
    private static string Inv(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Pct(double v) => v.ToString("0.0", CultureInfo.InvariantCulture) + "%";
    private static string Delta(double pp) => (pp >= 0 ? "+" : "−") + Math.Abs(pp).ToString("0.0", CultureInfo.InvariantCulture) + " pp";

    private int open = 3;
    private int seenRevision;
    private IlluminationIndex? index;

    private static string Pct0(double v) => v.ToString("0", CultureInfo.InvariantCulture) + "%";
    private static string Coords(Site s) => string.Format(CultureInfo.InvariantCulture, "{0:F2}°, {1:F2}°", s.Lat, s.Lon);
    private static string ShortDate(DateTime? d) => d is { } v ? VerdictText.Date(v) : "—";

    private IlluminationIndexSite? IndexFor(string id) => index?.Sites.FirstOrDefault(s => s.SiteId == id);

    private bool Done(int n) => n switch
    {
        1 => MissionState.SelectedSite is not null,
        2 => MissionState.SelectedLander is not null,
        _ => Analysis.HasResults && !Analysis.IsOutdated,
    };

    private string StepState(int n) => n == open ? "active" : Done(n) ? "done" : "next";

    private void Toggle(int n) => open = open == n ? 0 : n;

    private static string Circled(int n) => n switch { 1 => "①", 2 => "②", 3 => "③", _ => n.ToString() };

    /// <summary>A "To continue" link: open that step and bring it into view.</summary>
    private async Task GoToStep(int n)
    {
        open = n;
        StateHasChanged();
        await Task.Yield();
        await Ui.ScrollToAsync($"step-{n}");
    }
    private void Open(int n) => open = n;

    protected override async Task OnInitializedAsync()
    {
        try { index = await Repo.GetIndexAsync(); }
        catch (Exception ex) { Console.Error.WriteLine($"[ConfigPanel] index.json: {ex.Message}"); }
    }

    protected override void OnParametersSet() => SyncOpenStep();

    /// <summary>NEW LANDING (and other UiService requests) open a given step.</summary>
    private void SyncOpenStep()
    {
        if (Ui.OpenStepRevision == seenRevision) return;
        seenRevision = Ui.OpenStepRevision;
        open = Ui.OpenStep;
    }

    private static string? Day(DateTime? d) => d?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        MissionState.OnStateChanged += Refresh;
        Analysis.OnChanged += Refresh;
        Ui.OnChanged += Refresh;
    }

    private void Refresh() => InvokeAsync(() => { SyncOpenStep(); StateHasChanged(); });

    public void Dispose()
    {
        MissionState.OnStateChanged -= Refresh;
        Analysis.OnChanged -= Refresh;
        Ui.OnChanged -= Refresh;
    }

    private async Task OnSiteSelected(string siteId)
    {
        if (Ui.Landed) return;
        await MissionState.SelectSite(siteId);
    }

    private async Task OnStartDateChanged(string value)
    {
        if (DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal | DateTimeStyles.AssumeUniversal, out var date))
            await MissionState.UpdateWindowStart(date);
    }

    private async Task OnEndDateChanged(string value)
    {
        if (DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal | DateTimeStyles.AssumeUniversal, out var date))
            await MissionState.UpdateWindowEnd(date);
    }

    private async Task OnDurationChanged(string value)
    {
        if (double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var duration))
            await MissionState.UpdateMissionDuration(duration);
    }


    private async Task OnMinCommsChanged(string value)
    {
        if (double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var comms))
            await MissionState.UpdateMinComms(comms);
    }

    private async Task OnMinBatteryChanged(string value)
    {
        if (double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var battery))
            await MissionState.UpdateMinBattery(battery);
    }
}

@* Simplified, original schematic silhouettes (not derived from manufacturer imagery). *@
<svg class="lander-silhouette" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.25"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Kind)
    {
        case "starship_hls":
            @* Tall cylinder, pointed nose, legs at the base *@
            <path d="M48 100 V38 Q48 20 60 8 Q72 20 72 38 V100 Z" />
            <line x1="48" y1="44" x2="72" y2="44" />
            <circle cx="55" cy="36" r="1.6" />
            <circle cx="65" cy="36" r="1.6" />
            <line x1="48" y1="88" x2="72" y2="88" />
            <path d="M50 98 L40 112 M70 98 L80 112 M60 100 L60 112" />
            <path d="M35 112 H45 M75 112 H85 M56 112 H64" />
            break;

        case "blue_moon_mk2":
            @* Wide body, tall crew cabin, four legs *@
            <rect x="26" y="62" width="68" height="24" />
            <path d="M44 62 V30 Q44 22 52 22 H68 Q76 22 76 30 V62" />
            <rect x="54" y="30" width="12" height="8" />
            <line x1="26" y1="74" x2="94" y2="74" />
            <path d="M30 86 L16 108 M90 86 L104 108 M46 86 L42 108 M74 86 L78 108" />
            <path d="M11 108 H21 M99 108 H109 M37 108 H47 M73 108 H83" />
            break;

        case "nova_c":
            @* Hexagonal body on six legs *@
            <polygon points="40,40 80,40 92,62 80,84 40,84 28,62" />
            <line x1="40" y1="40" x2="40" y2="84" />
            <line x1="80" y1="40" x2="80" y2="84" />
            <path d="M54 84 L52 92 H68 L66 84" />
            <path d="M60 40 V30 M54 30 Q60 24 66 30" />
            <path d="M32 74 L18 104 M40 84 L32 106 M50 84 L46 108 M70 84 L74 108 M80 84 L88 106 M88 74 L102 104" />
            <path d="M14 104 H22 M28 106 H36 M42 108 H50 M70 108 H78 M84 106 H92 M98 104 H106" />
            break;

        case "blue_ghost":
            @* Low, wide body with side panels, four legs *@
            <rect x="36" y="50" width="48" height="22" />
            <line x1="36" y1="58" x2="84" y2="58" />
            <rect x="12" y="36" width="18" height="30" />
            <line x1="12" y1="46" x2="30" y2="46" />
            <line x1="12" y1="56" x2="30" y2="56" />
            <rect x="90" y="36" width="18" height="30" />
            <line x1="90" y1="46" x2="108" y2="46" />
            <line x1="90" y1="56" x2="108" y2="56" />
            <path d="M30 54 H36 M84 54 H90" />
            <path d="M60 50 V38" />
            <circle cx="60" cy="35" r="3" />
            <path d="M40 72 L26 98 M80 72 L94 98 M50 72 L46 100 M70 72 L74 100" />
            <path d="M21 98 H31 M89 98 H99 M41 100 H51 M69 100 H79" />
            break;

        case "griffin":
            @* Wide, flat body on four legs *@
            <rect x="18" y="54" width="84" height="16" />
            <rect x="30" y="46" width="60" height="8" />
            <line x1="45" y1="46" x2="45" y2="54" />
            <line x1="75" y1="46" x2="75" y2="54" />
            <path d="M54 70 L52 78 H68 L66 70" />
            <path d="M24 70 L10 98 M96 70 L110 98 M42 70 L38 100 M78 70 L82 100" />
            <path d="M5 98 H15 M105 98 H115 M33 100 H43 M77 100 H87" />
            break;

        default:
            @* Custom lander: plus icon *@
            <circle cx="60" cy="60" r="30" stroke-dasharray="4 4" />
            <path d="M60 46 V74 M46 60 H74" stroke-width="2" />
            break;
    }
</svg>

@code {
    /// <summary>Lander preset id; unknown ids (e.g. custom_*) render the "+" icon.</summary>
    [Parameter] public string Kind { get; set; } = "";
}

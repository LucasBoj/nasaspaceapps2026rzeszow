@using System.Globalization
@using SeleneFrontend.Models
@using SeleneFrontend.Services
@implements IAsyncDisposable
@inject MissionConfigState MissionState
@inject IJSRuntime JS
@inject UiService Ui

<div class="segmented" role="group" aria-label="Lander type">
    @foreach (var (cls, label) in Classes)
    {
        var active = MissionState.SelectedLanderClass == cls;
        <button type="button" class="segmented-option @(active ? "active" : "")" aria-pressed="@(active ? "true" : "false")"
                @onclick="() => SelectClass(cls)">@label</button>
    }
</div>

@if (Ui.AnalystMode)
{
    <p class="class-help"><Term Key="clps">CLPS</Term> robotic delivery landers · <Term Key="hls">HLS</Term> crewed Artemis landers</p>
}

<div class="lander-grid" role="radiogroup" aria-label="Lander" @ref="gridRef">
    @{ var landers = MissionState.FilteredLanders; var tabStop = TabStopId(landers); }
    @foreach (var lander in landers)
    {
        var selected = MissionState.SelectedLander?.Id == lander.Id;
        <button type="button" data-card role="radio" aria-checked="@(selected ? "true" : "false")"
                tabindex="@(lander.Id == tabStop ? 0 : -1)"
                class="lander-card @(selected ? "selected" : "")"
                @key="lander.Id" @onclick="() => SelectLander(lander.Id)">
            <LanderSilhouette Kind="@lander.Id" />
            <span class="lander-card-name">@lander.Name</span>
            <span class="lander-card-maker">@lander.Manufacturer</span>
            @if (CardNumbers(lander) is { } nums)
            {
                <span class="lander-card-nums num">@nums</span>
            }
            @if (Difference(lander, landers) is { } diff)
            {
                <span class="lander-card-diff">@diff</span>
            }
            <span class="lander-card-quality" title="@QualityTitle(lander)">
                <span class="quality-dot" aria-hidden="true" style="--q: @QualityShare(lander)"></span>@QualityText(lander)
            </span>
        </button>
    }
</div>

@if (MissionState.SelectedLander is { } simple && !Ui.AnalystMode)
{
    @* The cards carry solar power · battery · built-to-last; only the provenance note stays below them. *@
    <p class="lander-keys-note">
        <Term Key="quality" AriaLabel="About data quality">ⓘ</Term>
        @QualityTitle(simple)
    </p>
}
@if (MissionState.SelectedLander is { } sel && Ui.AnalystMode)
{
    <div class="lander-detail" @key="sel.Id">
        <div class="lander-detail-title">SPECS · @sel.Name.ToUpperInvariant()</div>
        <table class="specs-table">
            <tbody>
                @foreach (var row in SpecRows(sel))
                {
                    var infoId = $"spec-info-{row.Key}";
                    var open = openInfo == row.Key;
                    <tr>
                        <th scope="row">@row.Label</th>
                        <td class="spec-value">
                            @if (row.Param is PanelLayout { IsFixed: true } layout)
                            {
                                <span class="spec-value-flex"><PanelDiagram Layout="layout" />@row.Display</span>
                            }
                            else
                            {
                                @row.Display
                            }
                        </td>
                        <td class="spec-kind"><KindBadge Kind="@row.Param.Kind" /></td>
                        <td class="spec-info">
                            <button type="button" class="info-btn" aria-label="@($"Source and note for {row.Label}")"
                                    aria-expanded="@(open ? "true" : "false")" aria-controls="@infoId"
                                    @onclick="() => ToggleInfo(row.Key)" @onkeydown="OnInfoKeyDown">ⓘ</button>
                            @if (open)
                            {
                                <div class="info-popover" id="@infoId" role="note" @onkeydown="OnInfoKeyDown">
                                    <p>@NoteText(row.Param)</p>
                                    @if (!string.IsNullOrEmpty(row.Param.SourceUrl))
                                    {
                                        <a href="@row.Param.SourceUrl" target="_blank" rel="noopener">Source ↗</a>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="specs-footnote">Values marked ASSUMPTION are class estimates where manufacturers publish no figures.</p>

        <div class="lander-impact" aria-live="polite">
            <div class="lander-detail-title">LANDER IMPACT</div>
            @foreach (var item in ImpactRows(sel))
            {
                <div class="impact-row">
                    <span class="impact-label">@item.Label</span>
                    <span class="impact-value @item.Tone">@item.Value</span>
                    <span class="impact-basis">
                        @if (item.WhatIf)
                        {
                            <span class="kind-badge whatif">WHAT-IF</span>
                        }
                        else if (item.Basis is not null)
                        {
                            <KindBadge Kind="@item.Basis" />
                        }
                    </span>
                </div>
            }
        </div>

        <details class="whatif-panel">
            <summary>What-if (advanced)</summary>
            <div class="whatif-body">
                @foreach (var slider in Sliders(sel))
                {
                    var changed = MissionState.IsWhatIf(slider.Key);
                    var current = MissionState.Effective(slider.Key) ?? slider.Data;
                    var inputId = $"whatif-{slider.Key}";
                    <div class="whatif-row">
                        <label for="@inputId">@slider.Label</label>
                        <span class="whatif-value">@Fmt(current) @slider.Unit</span>
                        @if (changed)
                        {
                            <span class="kind-badge whatif">WHAT-IF</span>
                        }
                        <input id="@inputId" type="range" min="@Fmt(slider.Min, raw: true)" max="@Fmt(slider.Max, raw: true)"
                               step="@Fmt(slider.Step, raw: true)" value="@Fmt(current, raw: true)"
                               @oninput="e => OnSlider(slider.Key, e)" />
                    </div>
                }
                @if (sel.BatteryRoundTripEff is { } eff)
                {
                    var idealBattery = MissionState.IdealBattery;
                    <div class="whatif-row">
                        <span class="whatif-label" id="whatif-battery-label"><Term Key="batteff">Battery losses</Term></span>
                        <span class="whatif-value">@(idealBattery ? "NONE (100%)" : $"{Fmt(Math.Round(eff.Value * 100))}% round trip")</span>
                        @if (idealBattery)
                        {
                            <span class="kind-badge whatif">WHAT-IF</span>
                        }
                        <div class="segmented whatif-segmented" role="group" aria-labelledby="whatif-battery-label">
                            <button type="button" class="segmented-option @(!idealBattery ? "active" : "")" aria-pressed="@(!idealBattery ? "true" : "false")"
                                    @onclick="() => MissionState.ClearWhatIf(MissionConfigState.WhatIfIdealBattery)">REAL (data)</button>
                            <button type="button" class="segmented-option @(idealBattery ? "active" : "")" aria-pressed="@(idealBattery ? "true" : "false")"
                                    @onclick="() => MissionState.SetWhatIf(MissionConfigState.WhatIfIdealBattery, 1)">IDEAL (no losses)</button>
                        </div>
                    </div>
                }
                @if (MissionState.HasFixedPanels)
                {
                    var ideal = MissionState.IdealTracking;
                    <div class="whatif-row">
                        <span class="whatif-label" id="whatif-panels-label"><Term Key="incidence">Panels</Term></span>
                        <span class="whatif-value">@(ideal ? "IDEAL TRACKING" : "FIXED")</span>
                        @if (ideal)
                        {
                            <span class="kind-badge whatif">WHAT-IF</span>
                        }
                        <div class="segmented whatif-segmented" role="group" aria-labelledby="whatif-panels-label">
                            <button type="button" class="segmented-option @(!ideal ? "active" : "")" aria-pressed="@(!ideal ? "true" : "false")"
                                    @onclick="() => MissionState.ClearWhatIf(MissionConfigState.WhatIfIdealTracking)">FIXED (data)</button>
                            <button type="button" class="segmented-option @(ideal ? "active" : "")" aria-pressed="@(ideal ? "true" : "false")"
                                    @onclick="() => MissionState.SetWhatIf(MissionConfigState.WhatIfIdealTracking, 1)">IDEAL (upper bound)</button>
                        </div>
                    </div>
                    @if (!ideal)
                    {
                        var manual = MissionState.HeadingOverrideDeg;
                        <div class="whatif-row">
                            <span class="whatif-label"><label for="whatif-heading">Landing heading</label> <Term Key="heading" AriaLabel="About the landing heading">?</Term></span>
                            <span class="whatif-value">@(manual is { } hd ? $"{Fmt(hd)}°" : "AUTO")</span>
                            @if (manual is not null)
                            {
                                <button type="button" class="hud-btn small" @onclick="() => MissionState.ClearWhatIf(MissionConfigState.WhatIfHeadingDeg)">AUTO</button>
                            }
                            else
                            {
                                <span class="whatif-hint">best for each landing</span>
                            }
                            <input id="whatif-heading" type="range" min="0" max="355" step="5" value="@Fmt(manual ?? 0, raw: true)"
                                   aria-valuetext="@(manual is { } v ? $"{Fmt(v)} degrees" : "AUTO")"
                                   @oninput="e => OnSlider(MissionConfigState.WhatIfHeadingDeg, e)" />
                        </div>
                    }
                }
                @if (!MissionState.HasWhatIf)
                {
                    <p class="reason" id="whatif-reset-reason">Nothing to reset — the sliders show the lander data.</p>
                }
                <button type="button" class="btn-secondary whatif-reset" disabled="@(!MissionState.HasWhatIf)"
                        aria-describedby="@(MissionState.HasWhatIf ? null : "whatif-reset-reason")"
                        @onclick="MissionState.ResetWhatIf">Reset to data</button>
            </div>
        </details>
    </div>
}

@code {
    private static readonly (string Class, string Label)[] Classes =
    [
        ("clps", "Robotic"),
        ("hls", "Crewed"),
    ];

    // ---- data quality ("● 4/7 sourced") and plain-language key facts (SIMPLE mode)

    private static int Total(LanderPreset l) => l.AllParams.Count();
    private static string QualityText(LanderPreset l) => $"{l.CountKind(ParamKind.Sourced)}/{Total(l)} sourced";
    private static string QualityShare(LanderPreset l) =>
        (Total(l) == 0 ? 0 : (double)l.CountKind(ParamKind.Sourced) / Total(l)).ToString("0.00", CultureInfo.InvariantCulture);

    private static string QualityTitle(LanderPreset l)
    {
        var total = Total(l);
        var parts = new List<string> { $"{l.CountKind(ParamKind.Sourced)} of {total} values come from a published source" };
        if (l.CountKind(ParamKind.Derived) is var d and > 0) parts.Add($"{d} derived from published figures");
        if (l.CountKind(ParamKind.Assumption) is var a and > 0) parts.Add($"{a} {(a == 1 ? "is a class estimate" : "are class estimates")}");
        return string.Join(", ", parts) + ".";
    }

    /// <summary>Hours the battery carries the survival load in darkness, down to the battery threshold (derived from landers.json).</summary>
    private double? DarkHours(LanderPreset l) =>
        l.BatteryWh is { } b && l.SurvivalLoadW is { Value: > 0 } s ? b.Value * (1 - MissionState.MinBatteryPercent / 100) / s.Value : null;

    private string? CardNumbers(LanderPreset l)
    {
        if (l.SolarArrayW is null || l.BatteryWh is null) return null;
        var kwh = l.BatteryWh.Value / 1000;
        var days = l.MissionDurationDays is { } m ? $" · {m.Value.ToString("0.#", CultureInfo.InvariantCulture)} d" : "";
        return $"{Fmt(l.SolarArrayW.Value)} W · {kwh.ToString(kwh >= 10 ? "0" : "0.0", CultureInfo.InvariantCulture)} kWh{days}";
    }

    /// <summary>One sentence on what sets this lander apart from the others in its class (ranks of the data, nothing invented).</summary>
    private string? Difference(LanderPreset l, List<LanderPreset> all)
    {
        if (DarkHours(l) is not { } h) return null;
        var hs = all.Select(DarkHours).OfType<double>().ToList();
        var hours = h.ToString("0", CultureInfo.InvariantCulture);
        if (hs.Count < 3) return $"Battery carries it ~{hours} h through darkness.";
        if (h >= hs.Max()) return $"Longest reserve: ~{hours} h on battery in darkness.";
        if (h <= hs.Min()) return $"Smallest reserve: ~{hours} h on battery — needs steady sunlight.";
        if (l.SolarArrayW is { } a && all.All(x => x.SolarArrayW is null || x.SolarArrayW.Value <= a.Value))
            return l.DayLoadW is { } d ? $"Most solar power, but also the largest day load ({Fmt(d.Value)} W)." : "Most solar power.";
        return $"~{hours} h on battery in darkness.";
    }

    private ElementReference gridRef;
    private IJSObjectReference? gridModule;
    private string? openInfo;

    private record SpecRow(string Key, string Label, LanderParam Param, string Display);
    private record ImpactRow(string Label, string Value, string? Basis, bool WhatIf, string Tone = "");
    private record Slider(string Key, string Label, string Unit, double Data, double Min, double Max, double Step);

    /// <summary>Invariant number formatting; thousands separators for display, plain for attributes.</summary>
    private static string Fmt(double v, bool raw = false)
    {
        if (raw) return v.ToString("0.###", CultureInfo.InvariantCulture);
        return v.ToString(Math.Abs(v % 1) < 1e-9 ? "#,0" : "#,0.0", CultureInfo.InvariantCulture);
    }

    private static IEnumerable<SpecRow> SpecRows(LanderPreset l)
    {
        static string Num(NumberParam p) => $"{Fmt(p.Value)} {p.Unit}".Trim();
        if (l.SolarArrayW is { } a) yield return new("solar", "Solar array", a, Num(a));
        if (l.Panels is { } pl) yield return new("panels", "Panels", pl, PanelsText(pl));
        if (l.BatteryWh is { } b) yield return new("battery", "Battery", b, Num(b));
        if (l.BatteryRoundTripEff is { } e) yield return new("batteff", "Battery efficiency", e, $"{Fmt(Math.Round(e.Value * 100))}% round trip");
        if (l.DayLoadW is { } d) yield return new("dayload", "Day load", d, Num(d));
        if (l.SurvivalLoadW is { } s) yield return new("survival", "Survival load", s, Num(s));
        if (l.MissionDurationDays is { } m) yield return new("duration", "Mission duration", m, Num(m));
        if (l.DesignedForNight is { } n) yield return new("night", "Night survival", n, n.Value ? "DESIGNED" : "NOT DESIGNED");
        if (l.Crew is { } c) yield return new("crew", "Crew", c, Num(c));
        if (l.PayloadKg is { } p) yield return new("payload", "Payload", p, Num(p));
        if (l.LandingAccuracyM is { } acc) yield return new("ellipse", "Landing accuracy", acc, $"±{Fmt(acc.Value)} m");
    }

    private static string PanelsText(PanelLayout p)
    {
        if (!p.IsFixed) return "IDEAL TRACKING";
        var walls = p.Facets.Count(f => f.Share > 0 && f.NormalElevDeg < 60);
        var decks = p.Facets.Count(f => f.Share > 0 && f.NormalElevDeg >= 60);
        var parts = new List<string>();
        if (walls > 0) parts.Add($"{walls} wall");
        if (decks > 0) parts.Add($"{decks} deck");
        return "FIXED · " + string.Join(" + ", parts);
    }

    private static string NoteText(LanderParam p) =>
        !string.IsNullOrWhiteSpace(p.Note) ? p.Note
        : p.IsAssumption ? "Class estimate — no published figure."
        : "See source.";

    private static string Weakest(params LanderParam?[] inputs) => ParamKind.Weakest(inputs);

    private IEnumerable<ImpactRow> ImpactRows(LanderPreset l)
    {
        var battery = MissionState.Effective(MissionConfigState.WhatIfBatteryWh);
        var survival = MissionState.Effective(MissionConfigState.WhatIfSurvivalLoadW);
        var solar = MissionState.Effective(MissionConfigState.WhatIfSolarArrayW);

        if (battery is > 0 && survival is > 0)
        {
            var whatIf = MissionState.IsWhatIf(MissionConfigState.WhatIfBatteryWh) || MissionState.IsWhatIf(MissionConfigState.WhatIfSurvivalLoadW);
            // Usable energy after discharge losses (√η of the round-trip efficiency).
            var usable = battery.Value * Math.Sqrt(MissionState.BatteryRoundTripEff);
            yield return new("Survives darkness", $"≈ {Fmt(Math.Round(usable / survival.Value, 1))} h",
                Weakest(l.BatteryWh, l.BatteryRoundTripEff, l.SurvivalLoadW), whatIf || MissionState.IdealBattery);
        }

        if (solar is not null && l.DayLoadW is { } day)
        {
            var margin = solar.Value - day.Value;
            yield return new("Daylight margin", $"≈ {(margin >= 0 ? "+" : "−")}{Fmt(Math.Abs(margin))} W",
                Weakest(l.SolarArrayW, l.DayLoadW), MissionState.IsWhatIf(MissionConfigState.WhatIfSolarArrayW),
                margin < 0 ? "negative" : "");
        }

        // How much a fixed array loses when the low polar Sun (≈ 3° high) is 90° off the lander's front.
        if (solar is not null && PanelModel.For(l.Panels) is { } model && !MissionState.IdealTracking)
        {
            var sideOn = solar.Value * SolarGeometry.Factor(model, 3, 90, 0);
            var tone = l.DayLoadW is { } dl && sideOn < dl.Value ? "warn" : "";
            yield return new("Sun 90° off the front", $"≈ {Fmt(Math.Round(sideOn))} W",
                Weakest(l.SolarArrayW, l.Panels), MissionState.IsWhatIf(MissionConfigState.WhatIfSolarArrayW), tone);
        }

        if (l.MissionDurationDays is { } m)
            yield return new("Mission duration", $"{Fmt(m.Value)} d", m.Kind, false);

        if (l.DesignedForNight is { } n)
            yield return new("Night survival", n.Value ? "DESIGNED" : "NOT DESIGNED", n.Kind, false, n.Value ? "" : "warn");
    }

    private static IEnumerable<Slider> Sliders(LanderPreset l)
    {
        static Slider Make(string key, string label, NumberParam p)
        {
            var step = NiceStep(p.Value / 100);
            return new(key, label, p.Unit, p.Value, step, Math.Ceiling(p.Value * 3 / step) * step, step);
        }
        if (l.SolarArrayW is { } a) yield return Make(MissionConfigState.WhatIfSolarArrayW, "Solar array", a);
        if (l.BatteryWh is { } b) yield return Make(MissionConfigState.WhatIfBatteryWh, "Battery", b);
        if (l.SurvivalLoadW is { } s) yield return Make(MissionConfigState.WhatIfSurvivalLoadW, "Survival load", s);
    }

    /// <summary>1, 2 or 5 × 10^n closest to (and not above) the raw step.</summary>
    private static double NiceStep(double raw)
    {
        if (raw <= 0) return 1;
        var pow = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        var f = raw / pow;
        return (f >= 5 ? 5 : f >= 2 ? 2 : 1) * pow;
    }

    private void OnSlider(string key, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v))
            MissionState.SetWhatIf(key, v);
    }

    private void ToggleInfo(string key) => openInfo = openInfo == key ? null : key;

    private void OnInfoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") openInfo = null;
    }

    // Roving tabindex: the selected card (or the first one) is the single Tab stop of the grid.
    private string? TabStopId(List<LanderPreset> landers) =>
        landers.FirstOrDefault(l => l.Id == MissionState.SelectedLander?.Id)?.Id ?? landers.FirstOrDefault()?.Id;

    protected override void OnInitialized()
    {
        MissionState.OnStateChanged += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            gridModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cardGrid.js");
            await gridModule.InvokeVoidAsync("attach", gridRef);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[LanderPicker] Keyboard navigation unavailable: {ex.Message}");
        }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private Task SelectClass(string cls) =>
        cls == MissionState.SelectedLanderClass ? Task.CompletedTask : MissionState.SelectLanderClass(cls);

    private Task SelectLander(string id)
    {
        openInfo = null;
        Ui.ConfirmLander();
        return MissionState.SelectLander(id);
    }

    public async ValueTask DisposeAsync()
    {
        MissionState.OnStateChanged -= HandleStateChanged;
        if (gridModule is not null)
        {
            try
            {
                await gridModule.InvokeVoidAsync("detach", gridRef);
                await gridModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}

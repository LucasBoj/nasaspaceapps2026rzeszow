@using System.Globalization
@using SeleneFrontend.Models
@using SeleneFrontend.Services
@implements IDisposable
@inject UiService Ui
@inject AnalysisService Analysis

@* End of the mission replay (or the static summary with reduced motion). *@
@if (Ui.ReplayOutcome is { } folded && Ui.SummaryCollapsed && Analysis.Mission is not null)
{
    @* Folded (non-modal): one small button brings the card back. *@
    <button type="button" class="replay-summary-chip @(folded == "lost" ? "lost" : "complete")" @onclick="Ui.ExpandSummary">
        ▴ Mission summary · @(folded == "lost" ? "MISSION LOST" : "MISSION COMPLETE")
    </button>
}
else if (Ui.ReplayOutcome is { } outcome && Analysis.Mission is { } m)
{
    var lost = outcome == "lost";
    <section id="replay-summary" class="replay-summary @(lost ? "lost" : "complete")" aria-labelledby="replay-title">
        <div role="status" aria-live="polite">
            <p class="replay-kicker">@VerdictText.Icon(m.Verdict) @VerdictText.Label(m.Verdict) · @Analysis.MissionSiteName</p>
            <h2 id="replay-title" class="replay-title">@Title(outcome, m)</h2>
        </div>
        <dl class="verdict-numbers replay-numbers">
            <div><dt>Mission time</dt><dd>@Days(m)</dd></div>
            <div><dt>Sunlight</dt><dd>@P(m.SunPct)<small>%</small></dd></div>
            <div><dt>Lowest battery</dt><dd>@P(m.MinSocPct)<small>%</small></dd></div>
            <div><dt>Earth contact</dt><dd>@P(m.CommsPct)<small>%</small></dd></div>
            <div><dt>Longest darkness</dt><dd>@Hours(m.LongestDarkH)</dd></div>
        </dl>
        @if (Ui.IsDemoResult)
        {
            @* QUICK DEMO: the same tool tells a working date from a failing one. *@
            <div class="demo-next">
                <button type="button" class="btn-secondary small counter-example" @onclick="Ui.ShowCounterExampleAsync">@DemoScenario.CounterText</button>
                <button type="button" class="link-btn best-window" @onclick="Ui.ShowBestWindowAsync">Show the best landing window</button>
            </div>
        }
        else if (Ui.IsCounterResult)
        {
            <div class="demo-next">
                <span class="demo-note">Same site and lander as the demo, landing @VerdictText.Date(DemoScenario.CounterLandingUtc) instead of @VerdictText.Date(DemoScenario.LandingUtc).</span>
                <button type="button" class="link-btn best-window" @onclick="Ui.ShowBestWindowAsync">Show the best landing window</button>
            </div>
        }
        <div class="verdict-actions">
            <button type="button" class="btn-primary small replay-again" @onclick="Ui.PlayMissionAsync" disabled="@(!Ui.CanPlayMission || Ui.ReducedMotion)"
                    aria-describedby="@(Ui.ReducedMotion ? "replay-reason" : null)">↻ Replay</button>
            <button type="button" class="btn-secondary small" @onclick="Ui.ShowHeatmapAsync">Try another date</button>
            <button type="button" class="btn-secondary small" @onclick="Ui.NewLanding">New landing</button>
            <button type="button" class="link-btn full-analysis-hint" @onclick="FullAnalysis">See the full analysis →</button>
            <button type="button" class="link-btn summary-hide" @onclick="Ui.CollapseSummary" aria-controls="replay-summary">Hide <span class="kbd">Esc</span></button>
            <button type="button" class="link-btn" @onclick="Ui.CloseReplay">Close</button>
        </div>
        @if (Ui.ReducedMotion)
        {
            <p class="reason" id="replay-reason">Reduced motion is on, so the mission is summarised instead of played back.</p>
        }
    </section>
}

@code {
    private static string P(double v) => Math.Round(v).ToString("0", CultureInfo.InvariantCulture);
    private static string Hours(double h) => h >= 48 ? $"{(h / 24).ToString("0.0", CultureInfo.InvariantCulture)} d" : $"{Math.Round(h).ToString("0", CultureInfo.InvariantCulture)} h";

    private static string Days(SimulationResult m) => m.DepletedAtStep is { } d
        ? $"{(d * m.StepHours / 24).ToString("0.0", CultureInfo.InvariantCulture)} of {VerdictText.Days(m.DurationDays)}"
        : VerdictText.Days(m.DurationDays);

    private static string Title(string outcome, SimulationResult m) => outcome switch
    {
        "lost" => $"MISSION LOST · day {m.MissionDay(m.DepletedAtStep ?? 0)} · battery depleted{(m.Reason.Contains("darkness", StringComparison.Ordinal) ? " in darkness" : "")}",
        "complete-hls" => "MISSION COMPLETE · lift-off from the surface",
        _ => "MISSION COMPLETE · end of operations",
    };

    private async Task FullAnalysis()
    {
        Ui.CloseReplay();
        await Ui.ShowFullAnalysisAsync();
    }

    protected override void OnInitialized() { Ui.OnChanged += Refresh; Analysis.OnChanged += Refresh; }
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() { Ui.OnChanged -= Refresh; Analysis.OnChanged -= Refresh; }
}

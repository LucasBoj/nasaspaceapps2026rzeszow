@using System.Globalization
@using SeleneFrontend.Models
@using SeleneFrontend.Services

@* How much the verdict trusts its inputs, in two groups: power assumptions (load ±20 %) and landing accuracy
   (the lander's landing ellipse, with its map beside the text, and the NASA map one 120 m pixel off). *@
<div class="robustness" role="group" aria-label="Verdict robustness">
    @if (Load is not null || Height is not null)
    {
        <section class="robust-group" aria-labelledby="robust-power">
            <h4 class="robust-group-title" id="robust-power">Power assumptions</h4>
            @if (Load is { } s)
            {
                <div class="robust-item">
                    <span class="robust-label"><Term Key="loadsens">Load ±@Pct0(s.DeltaFraction * 100)</Term></span>
                    <span class="robust-badge @(s.Robust ? "ok" : "warn")">@(s.Robust ? "ROBUST" : "SENSITIVE")</span>
                    <span class="robust-detail">
                        −@Pct0(s.DeltaFraction * 100):
                        <span class="@VerdictClass(s.Low)">@VerdictLabel(s.Low)</span> (min @Pct0(s.MinSocLowPct))
                        · +@Pct0(s.DeltaFraction * 100):
                        <span class="@VerdictClass(s.High)">@VerdictLabel(s.High)</span> (min @Pct0(s.MinSocHighPct))
                        · @BreakEven(s)
                    </span>
                </div>
            }
            @if (Height is { } h)
            {
                <div class="robust-item">
                    <span class="robust-label"><Term Key="panelheight">Panels @Num(h.Low.HeightM)–@Num(h.High.HeightM) m</Term></span>
                    <span class="robust-badge @(h.Robust ? "ok" : "warn")">@(h.Robust ? "ROBUST" : "SENSITIVE")</span>
                    <span class="robust-detail">
                        @Num(h.Low.HeightM) m: <span class="@VerdictClass(h.Low.Verdict)">@VerdictLabel(h.Low.Verdict)</span>
                        (sunlight @Pct0(h.Low.SunPct), min @Pct0(h.Low.MinSocPct))
                        · @Num(h.High.HeightM) m: <span class="@VerdictClass(h.High.Verdict)">@VerdictLabel(h.High.Verdict)</span>
                        (sunlight @Pct0(h.High.SunPct), min @Pct0(h.High.MinSocPct))
                        · this lander @Num(h.NominalHeightM) m: sunlight @Pct0(h.NominalSunPct)
                    </span>
                </div>
            }
        </section>
    }
    @if (Ellipse is not null || (Nasa is { } nc && !double.IsNaN(nc.NearLossPp)))
    {
        <section class="robust-group accuracy" aria-labelledby="robust-accuracy">
            <h4 class="robust-group-title" id="robust-accuracy">Landing accuracy</h4>
            <div class="robust-group-body">
                @if (Ellipse is { } em)
                {
                    <svg class="ellipse-map" viewBox="@ViewBox(em)" role="img" aria-label="@MapLabel(em)">
                        <title>@MapLabel(em)</title>
                        @foreach (var p in em.Points)
                        {
                            <rect x="@Num(p.E - em.SpacingM / 2)" y="@Num(-p.N - em.SpacingM / 2)" width="@Num(em.SpacingM)" height="@Num(em.SpacingM)"
                                  class="ep @PointClass(p.Verdict)" />
                        }
                        <circle cx="0" cy="0" r="@Num(em.RadiusM)" class="ep-ring" />
                        <path d="@Cross(em)" class="ep-target" />
                        <text x="0" y="@Num(-em.RadiusM - em.SpacingM * 0.9)" class="ep-north">N</text>
                    </svg>
                }
                <div class="robust-items">
                @if (Ellipse is { } e)
                {
                    var share = e.FeasibleShare * 100;
                    var holds = share >= EllipseOkPct;
                    <div class="robust-item ellipse-item">
                        <span class="robust-label"><Term Key="ellipse">Ellipse ±@Pct0Num(e.RadiusM) m</Term></span>
                        <span class="robust-badge @(holds ? "ok" : "warn")">@Pct0(share) FEASIBLE</span>
                        <span class="robust-detail">
                            @e.Count spots within @Pct0Num(e.RadiusM) m:
                            <span class="v-feasible">@e.Feasible FEASIBLE</span>
                            @if (e.Marginal > 0) { <text> · </text><span class="v-marginal">@e.Marginal MARGINAL</span> }
                            @if (e.NotFeasible > 0) { <text> · </text><span class="v-nogo">@e.NotFeasible NOT FEASIBLE</span> }
                            · sunlight @Pct0(e.MinSunPct)–@Pct0(e.MaxSunPct) of the mission
                            @if (e.MaxSlopeDeg is { } slope)
                            {
                                <text> · steepest slope @slope.ToString("0.0", CultureInfo.InvariantCulture)° (120 m DEM)</text>
                            }
                            @if (Accuracy is { } acc)
                            {
                                <text> · </text>
                                <span class="robust-source" title="@acc.Note">radius @KindLabel(acc.Kind)@if (!string.IsNullOrEmpty(acc.SourceUrl))
                                    {
                                        <text> (</text><a href="@acc.SourceUrl" target="_blank" rel="noopener">source</a><text>)</text>
                                    }</span>
                            }
                        </span>
                    </div>
                }
                @if (Nasa is { } n && !double.IsNaN(n.NearLossPp))
                {
                    <div class="robust-item">
                        <span class="robust-label"><Term Key="pointspread">One pixel off (120 m)</Term></span>
                        <span class="robust-badge @(n.NearLossPp >= SpreadWarnPp ? "warn" : "ok")">@(n.NearLossPp >= SpreadWarnPp ? "POINT-SENSITIVE" : "STABLE")</span>
                        <span class="robust-detail">
                            NASA LOLA map, sunlit time: this point @Pct1(n.NasaSunPct), within one 120 m pixel
                            @Pct1(n.NasaSunMinNearPct)–@Pct1(n.NasaSunMaxNearPct)
                            @if (n.NearLossPp >= SpreadWarnPp)
                            {
                                <text> · a landing 120 m off can lose up to @Pp1(n.NearLossPp) of sunlight</text>
                            }
                        </span>
                    </div>
                }
                </div>
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public LoadSensitivity? Load { get; set; }
    [Parameter] public NasaSiteCheck? Nasa { get; set; }
    [Parameter] public EllipseResult? Ellipse { get; set; }
    /// <summary>The mission with the panels at 1 m and 3 m instead of the model's 2 m.</summary>
    [Parameter] public PanelHeightSensitivity? Height { get; set; }
    /// <summary>The lander's landing accuracy (radius of the ellipse) with its provenance.</summary>
    [Parameter] public NumberParam? Accuracy { get; set; }

    /// <summary>Sunlight lost within one pixel above which a site counts as point-sensitive (pp).</summary>
    private const double SpreadWarnPp = 10;

    /// <summary>Share of the landing area that must stay FEASIBLE for the ellipse badge to show as fine (%).</summary>
    private const double EllipseOkPct = 90;

    private static string Num(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
    private static string Pct0Num(double v) => Math.Round(v).ToString("0", CultureInfo.InvariantCulture);

    private static string ViewBox(EllipseResult e)
    {
        var half = e.RadiusM + e.SpacingM * 1.6;      // room for the cells on the rim and the N label
        return $"{Num(-half)} {Num(-half)} {Num(2 * half)} {Num(2 * half)}";
    }

    private static string Cross(EllipseResult e)
    {
        var a = e.SpacingM * 0.9;
        return $"M{Num(-a)} 0H{Num(a)}M0 {Num(-a)}V{Num(a)}";
    }

    private static string PointClass(Verdict v) => v switch
    {
        Verdict.Feasible => "ep-ok",
        Verdict.Marginal => "ep-marginal",
        _ => "ep-nogo",
    };

    private static string MapLabel(EllipseResult e) =>
        $"Landing ellipse map, north up, target in the middle: {e.Feasible} of {e.Count} spots FEASIBLE, " +
        $"{e.Marginal} MARGINAL, {e.NotFeasible} NOT FEASIBLE.";

    private static string KindLabel(string kind) => ParamKind.Label(kind);

    private static string BreakEven(LoadSensitivity s) => s.FeasibleUpToFactor switch
    {
        null => "not FEASIBLE at any load (Earth contact or limits)",
        { } f when f >= s.MaxFactor => $"FEASIBLE even at {Pct0(s.MaxFactor * 100)} of nominal load",
        { } f when f >= 1 => $"FEASIBLE up to +{Pct0((f - 1) * 100)} load",
        { } f => $"FEASIBLE only below −{Pct0((1 - f) * 100)} load",
    };

    private static string VerdictLabel(Verdict v) => v switch
    {
        Verdict.Feasible => "FEASIBLE",
        Verdict.Marginal => "MARGINAL",
        _ => "NOT FEASIBLE",
    };

    private static string VerdictClass(Verdict v) => v switch
    {
        Verdict.Feasible => "v-feasible",
        Verdict.Marginal => "v-marginal",
        _ => "v-nogo",
    };

    private static string Pct0(double v) => Math.Round(v).ToString("0", CultureInfo.InvariantCulture) + "%";
    private static string Pp1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture) + " pp";
    private static string Pct1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture) + "%";
}

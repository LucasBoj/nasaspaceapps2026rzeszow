@using SeleneFrontend.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="heatmap">
    <div class="segmented heatmap-modes" role="group" aria-label="Heatmap colouring">
        @foreach (var (key, label) in Modes)
        {
            var active = mode == key;
            <button type="button" class="segmented-option @(active ? "active" : "")" aria-pressed="@(active ? "true" : "false")"
                    @onclick="() => SetModeAsync(key)">@label</button>
        }
    </div>
    <div class="heatmap-canvas-wrap">
        <canvas @ref="canvas" class="heatmap-canvas" role="img" aria-label="@AriaLabel"></canvas>
        <div @ref="tooltip" class="heatmap-tooltip" hidden></div>
    </div>
    <div class="heatmap-legend" aria-hidden="true">
        @switch (mode)
        {
            case "light":
                <span class="legend-scale light"></span><span>lit hours 0 → 100 % (≥ 50 % of the solar disk)</span>
                break;
            case "energy":
                <span class="legend-scale energy-deficit"></span><span>deficit 0 → 1×</span>
                <span class="legend-scale energy-surplus"></span><span>surplus 1 → 2× (solar produced / used)</span>
                break;
            case "earth":
                <span class="legend-scale"></span><span>Earth in view 0 → 100 % of hours</span>
                break;
            default:
                <span class="legend-swatch nogo"></span><span>not feasible</span>
                <span class="legend-scale"></span><span>score 1 → 100</span>
                break;
        }
        <span class="legend-best"></span><span>best window (by score)</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public HeatmapResult Result { get; set; } = null!;
    [Parameter] public (int Site, int Day) Selected { get; set; } = (-1, -1);
    [Parameter] public EventCallback<(int Site, int Day)> OnCellClick { get; set; }

    /// <summary>Change to make the BEST WINDOW cell pulse once (QUICK DEMO).</summary>
    [Parameter] public int Pulse { get; set; }

    private static readonly (string Key, string Label)[] Modes =
    [
        ("score", "SCORE"),
        ("light", "LIGHT"),
        ("energy", "ENERGY"),
        ("earth", "EARTH"),
    ];

    private string mode = "score";

    private string AriaLabel => mode switch
    {
        "light" => "Heatmap of the share of sunlit hours per region and landing day",
        "energy" => "Heatmap of solar energy produced versus used per region and landing day",
        "earth" => "Heatmap of the share of hours with Earth in view per region and landing day",
        _ => "Heatmap of landing feasibility score per region and landing day",
    } + "; use the best-date buttons below to select with the keyboard.";

    private async Task SetModeAsync(string key)
    {
        if (mode == key) return;
        mode = key;
        if (module is null) return;
        try { await module.InvokeVoidAsync("setMode", canvas, mode); }
        catch (JSDisconnectedException) { }
    }

    private ElementReference canvas;
    private ElementReference tooltip;
    private IJSObjectReference? module;
    private DotNetObjectReference<LandingHeatmap>? selfRef;
    private HeatmapResult? drawnResult;
    private (int, int) drawnSelected = (-2, -2);
    private int drawnPulse = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var newPulse = Pulse != 0 && Pulse != drawnPulse;
        if (ReferenceEquals(drawnResult, Result) && drawnSelected == Selected && !newPulse) return;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/heatmap.js");
            selfRef ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("render", canvas, tooltip, Payload(), selfRef);
            drawnResult = Result;
            drawnSelected = Selected;
            if (Pulse != 0) drawnPulse = Pulse;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private object Payload()
    {
        var sites = Result.Sites.Count;
        var n = sites * Result.Days;
        var scores = new double[n];
        var verdicts = new int[n];
        var sunPct = new double[n];
        var commsPct = new double[n];
        var energyRatio = new double[n];
        var minSoc = new double[n];
        var heading = new double[n];
        var efficiency = new double[n];
        // JSON has no NaN: −1 marks "not applicable" (ideal tracking, never lit).
        static double Num(double v, int digits) => double.IsFinite(v) ? Math.Round(v, digits) : -1;
        for (var s = 0; s < sites; s++)
        {
            for (var d = 0; d < Result.Days; d++)
            {
                var i = s * Result.Days + d;
                scores[i] = Math.Round(Result.Scores[s, d], 1);
                verdicts[i] = (int)Result.Verdicts[s, d];
                sunPct[i] = Num(Result.SunPct[s, d], 1);
                commsPct[i] = Num(Result.CommsPct[s, d], 1);
                energyRatio[i] = Num(Result.EnergyRatio[s, d], 3);
                minSoc[i] = Num(Result.MinSocPct[s, d], 1);
                heading[i] = Num(Result.HeadingDeg[s, d], 0);
                efficiency[i] = Num(Result.PanelEfficiency[s, d], 3);
            }
        }
        return new
        {
            sites = Result.Sites.Select(x => x.Name).ToArray(),
            days = Result.Days,
            firstDay = Result.FirstDayUtc.ToString("yyyy-MM-dd"),
            scores,
            verdicts,
            sunPct,
            commsPct,
            energyRatio,
            minSoc,
            heading,
            efficiency,
            mode,
            best = new[] { Result.BestSite, Result.BestDay },
            selected = new[] { Selected.Site, Selected.Day },
            pulse = Pulse != drawnPulse ? Pulse : 0,
        };
    }

    [JSInvokable]
    public Task OnCellClicked(int site, int day) => OnCellClick.InvokeAsync((site, day));

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose", canvas);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        selfRef?.Dispose();
    }
}

@using System.Net.Http.Json
@using Microsoft.Extensions.Configuration
@using SeleneFrontend.Models
@using SeleneFrontend.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IConfiguration Config
@inject MissionConfigState MissionState
@inject AnalysisService Analysis
@inject UiService Ui
@inject HttpClient Http
@inject IlluminationRepository Repo
@* CustomSiteService registers itself as the repository's custom-site provider when it is constructed. *@
@inject CustomSiteService Custom

<div class="moon-viewer-container">
    @* Cesium owns this element exclusively — Blazor must never render children into it. *@
    <div id="moon-viewer-element" class="moon-viewer-canvas"></div>
    @* Landing animation HUD: owned by landingAnimation.js — Blazor never renders children into it. *@
    <div class="landing-hud-host" @ref="landingHud"></div>
    @* Mission replay HUD: owned by missionReplay.js — Blazor never renders children into it. *@
    <div class="replay-hud-host" @ref="replayHud"></div>

    @if (!moonLoaded && initError is null)
    {
        <div class="loading-overlay skeleton-surface" aria-live="polite">
            <p>LOADING MOON VIEW…</p>
        </div>
    }
    @if (moonLoaded)
    {
        <div class="viewer-hud">
            <div class="viewer-hud-buttons">
                <button type="button" class="hud-btn" aria-label="Back to the south pole view (Home key)"
                        @onmouseenter="@(() => ShowTip("South pole view (Home key)"))" @onmouseleave="HideTip"
                        @onfocus="@(() => ShowTip("South pole view (Home key)"))" @onblur="HideTip"
                        @onclick="SouthPoleViewAsync">⌂ View</button>
                <button type="button" class="hud-btn" disabled="@(MissionState.SelectedSite is null)"
                        aria-describedby="@(MissionState.SelectedSite is null ? "zoom-reason" : null)" @onclick="ZoomToSiteAsync">Zoom to site</button>
                @if (terrain3D && MissionState.SelectedSite is not null && !Ui.LandingInProgress)
                {
                    @* Stand on the surface and look at the sky: Earth and Sun where the data puts them, hidden by real terrain. *@
                    <button type="button" class="hud-btn surface-view" aria-pressed="@(surfaceView ? "true" : "false")" @onclick="ToggleSurfaceViewAsync">
                        @(surfaceView ? "Back to orbit view" : "Surface view")
                    </button>
                }
                @if (Ui.CanPlayMission && !Ui.ReplayPlaying)
                {
                    <button type="button" class="hud-btn play-mission" @onclick="Ui.PlayMissionAsync">▶ Play mission</button>
                }
                @if (Ui.Landed && !Ui.LandingInProgress)
                {
                    <button type="button" class="hud-btn new-landing" @onclick="Ui.NewLanding">New landing</button>
                }
                @if (Ui.AnalystMode)
                {
                    <button type="button" class="hud-btn" aria-label="Viewer settings" aria-expanded="@(settingsOpen ? "true" : "false")" aria-controls="hud-settings"
                            @onmouseenter="@(() => ShowTip("Viewer settings"))" @onmouseleave="HideTip"
                            @onfocus="@(() => ShowTip("Viewer settings"))" @onblur="HideTip"
                            @onclick="ToggleSettings">⚙</button>
                    <button type="button" class="hud-btn" aria-pressed="@(Ui.CandidatesOn ? "true" : "false")"
                            disabled="@(!HasRegionSelected)" aria-describedby="@(HasRegionSelected ? "cand-tip" : "cand-reason")"
                            @onmouseenter="@(() => ShowTip(CandidatesTip))" @onmouseleave="HideTip"
                            @onfocus="@(() => ShowTip(CandidatesTip))" @onblur="HideTip"
                            @onclick="ToggleCandidates">Candidates</button>
                }
                @if (MissionState.Psr is not null && HasRegionSelected)
                {
                    <button type="button" class="hud-btn psr-toggle" aria-pressed="@(psrOn ? "true" : "false")"
                            @onmouseenter="@(() => ShowTip(PsrTip))" @onmouseleave="HideTip"
                            @onfocus="@(() => ShowTip(PsrTip))" @onblur="HideTip"
                            @onclick="TogglePsrAsync">Ice (PSR)</button>
                }
                @* HUD tooltip: in the button row, after the last button — never over another control. *@
                @if (hudTip is not null)
                {
                    <span class="hud-tip" role="tooltip" id="@(hudTip == CandidatesTip ? "cand-tip" : null)">@hudTip</span>
                }
            </div>
            @if (MissionState.SelectedSite is null)
            {
                <p class="hud-reason" id="zoom-reason">Choose a site to zoom to it.</p>
            }
            else if (Ui.AnalystMode && !HasRegionSelected)
            {
                <p class="hud-reason" id="cand-reason">Candidates are shown for the 9 regions — choose one.</p>
            }
            @if (settingsOpen && Ui.AnalystMode)
            {
                <div class="hud-settings" id="hud-settings">
                    <label>
                        <input type="checkbox" checked="@Ui.LandingAnimationEnabled"
                               @onchange="@((ChangeEventArgs e) => Ui.SetLandingAnimation(e.Value is true))" />
                        Landing animation
                    </label>
                    @if (Ui.ReducedMotion)
                    {
                        <small>Reduced motion is on — the landing shows as a short fade.</small>
                    }
                    <label>
                        <input type="checkbox" checked="@Ui.EnhanceView"
                               @onchange="@((ChangeEventArgs e) => Ui.SetEnhanceView(e.Value is true))" />
                        Enhance view
                    </label>
                    <small>Brighter on screen only. The pole really is this dark — the Sun stays a few degrees above the horizon. Light direction from JPL ephemerides.</small>
                </div>
            }
            @* Chips give way to the descent / replay HUD that uses this corner. Their tooltips open to the right. *@
            @if (badgeText is not null && Ui.AnalystMode && !Ui.LandingInProgress && !Ui.ReplayPlaying)
            {
                <div class="viewer-badge mode has-tip" tabindex="0">
                    @badgeText
                    @if (!string.IsNullOrEmpty(badgeTitle))
                    {
                        <span class="tip" role="tooltip">@badgeTitle</span>
                    }
                </div>
            }
            @if (Ui.LandingAnimationEnabled && !Ui.ReplayPlaying && !Ui.LandingInProgress && MissionState.SelectedLander is { Model: { } model } lander
                 && (Ui.AnalystMode || modelStatus.GetValueOrDefault(model.Uri) == "loading"))
            {
                var state = modelStatus.GetValueOrDefault(model.Uri);
                <div class="viewer-badge model-status has-tip @state" tabindex="0" role="status">
                    <span class="tip" role="tooltip">@($"{lander.Name} 3D model (visualisation only). {model.Credit}")</span>
                    @(state switch
                    {
                        "loading" => $"LOADING 3D MODEL · {lander.Name.ToUpperInvariant()}…",
                        "failed" => "SCHEMATIC MODEL (3D model unavailable)",
                        "ready" => $"3D MODEL · {lander.Name.ToUpperInvariant()} · STYLIZED",
                        _ => $"3D MODEL · {lander.Name.ToUpperInvariant()} · QUEUED",
                    })
                </div>
            }
            @if (psrOn && HasRegionSelected && MissionState.Psr?.SiteFor(MissionState.SelectedSite?.Id) is { } psrSite)
            {
                <div class="hud-legend psr-legend">
                    <span class="legend-swatch psr" aria-hidden="true"></span>
                    <span><Term Key="psr">Permanently shadowed</Term> craters within @MissionState.Psr.OutlineRadiusKm.ToString("0", System.Globalization.CultureInfo.InvariantCulture) km
                        (where water ice can be trapped) · nearest ≥ 1 km²: @psrSite.D1Km.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) km
                        · NASA LOLA, Mazarico et al. 2011</span>
                </div>
            }
            @if (Ui.CandidatesOn && HasRegionSelected)
            {
                <div class="hud-legend">
                    @if (candidateError is not null)
                    {
                        <span class="hud-legend-error">@candidateError</span>
                    }
                    else
                    {
                        <span class="legend-scale small"></span>
                        <span>@candidateCount candidate sites · color = % of hours lit · grey = rejected</span>
                        <span>Wueller et al. 2026 · sites near <Term Key="psr">PSRs</Term></span>
                    }
                </div>
            }
            @if (Custom.Status is { } customStatus)
            {
                <div class="hud-progress custom-progress" role="progressbar" aria-label="Custom site computation"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)(Custom.Progress * 100))">
                    <div class="hud-progress-bar" style="width: @((int)(Custom.Progress * 100))%"></div>
                    <span>@customStatus</span>
                </div>
            }
            @if (Analysis.IsRunning && (Ui.VerdictRequested || Ui.AnalystMode))
            {
                <div class="hud-progress" role="progressbar" aria-label="Analysis progress"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)(Analysis.Progress * 100))">
                    <div class="hud-progress-bar" style="width: @((int)(Analysis.Progress * 100))%"></div>
                    <span>Analyzing all 9 sites · @((int)(Analysis.Progress * 100))%</span>
                </div>
            }
        </div>
    }
    @if (moonLoaded && !Ui.LandingInProgress && !Ui.SummaryOpen)
    {
        <div class="viewer-compass"><SunEarthCompass /></div>
    }
    @if (!Ui.AnalystMode)
    {
        <VerdictCard />
    }
    @* Space Apps "Use of Super Intelligence": a visible mark whenever an AI-generated lander model is in the scene. *@
    @if (moonLoaded && Ui.LandingAnimationEnabled && (Ui.LandingInProgress || Ui.Landed)
         && MissionState.SelectedLander is { Model: { } aiModel } && modelStatus.GetValueOrDefault(aiModel.Uri) != "failed")
    {
        <div class="ai-model-badge" role="note" aria-label="AI-generated 3D model (Meshy AI + Microsoft TRELLIS.2, see Credits)">AI-generated 3D model</div>
    }
    <ReplaySummary />
    <WelcomeCard />
    @if (initError is not null)
    {
        <div class="token-error-overlay">
            <p style="font-weight: 500;">Moon viewer failed to initialize</p>
            <p style="font-size: 0.875rem; color: #7f93a6;">@initError</p>
        </div>
    }
</div>

@code {
    private bool moonLoaded;
    private string? initError;
    private string? badgeText;
    private IJSObjectReference? moonModule;
    private DotNetObjectReference<MoonPanel>? dotNetRef;
    private List<Site>? loadedSites;
    private string? badgeTitle;
    private ElementReference landingHud;
    private bool settingsOpen;
    private string? landedKey;      // "siteId|landerId" of the lander on the surface (or descending)
    private string? prefetchedFor;  // site whose landing module + ground height are already warm
    private bool modelPreloadStarted;
    private readonly Dictionary<string, string> modelStatus = new();   // model uri → loading | ready | failed

    private sealed class LandingResult
    {
        public string Status { get; set; } = "";
        public double Fps { get; set; }
        public bool Simplified { get; set; }
        public string? Model { get; set; }   // "gltf" or "schematic"
    }
    private bool introPending;
    private string? candidatesShownFor;
    private string? candidateError;
    private int candidateCount;

    private bool HasRegionSelected =>
        MissionState.SelectedSite is { } s && MissionState.AvailableSites.Any(a => a.Id == s.Id);

    private sealed record CandidateFile(List<CandidatePoint> Candidates);
    private sealed record CandidatePoint(string CandidateId, double Lat, double Lon, double? SunPct, double? EarthPct, bool Rejected, string Reason);

    public class InitResult
    {
        public bool TerrainLoaded { get; set; }
        public bool HasToken { get; set; }
    }

    protected override void OnInitialized()
    {
        MissionState.OnStateChanged += HandleStateChanged;
        MissionState.OnFlyToRequested += HandleFlyToRequested;
        Analysis.OnChanged += HandleAnalysisChanged;
        Ui.OnChanged += HandleUiChanged;
        Ui.IntroRequested += HandleIntro;
        Ui.LandingRequested += HandleLandingRequested;
        Ui.NewLandingRequested += HandleNewLanding;
        Ui.ReplayRequested += HandleReplayRequested;
        Ui.SiteHoverChanged += HandleSiteHover;
        Custom.OnChanged += HandleCustomChanged;
        Ui.HoverTimeChanged += HandleHoverTime;
    }

    private void HandleLandingRequested(LandingRequest req) => _ = InvokeAsync(() => PlayLandingAsync(req));

    private async Task PlayLandingAsync(LandingRequest req)
    {
        var status = "unavailable";
        try
        {
            if (moonLoaded && moonModule is not null)
            {
                landedKey = $"{req.SiteId}|{req.LanderId}";
                landingMissionVersion = req.MissionVersion;
                lastHeadingKey = null;
                var mission = FreshMission(req.SiteId);
                var options = new
                {
                    lat = req.Lat, lon = req.Lon, landerClass = req.LanderClass,
                    landerName = req.LanderName, siteName = req.SiteName, reducedMotion = req.ReducedMotion,
                    model = req.Model,
                    panels = req.Panels?.Select(f => new { f.AzOffsetDeg, f.NormalElevDeg, f.Share }).ToArray(),
                    // Usually still null here: the analysis answers ~1 s into the descent (SyncLanderHeadingAsync).
                    headingDeg = mission is { FixedPanels: true } ? mission.HeadingDeg : null,
                    headingAuto = mission?.HeadingAuto ?? true,
                };
                if (mission is not null) lastHeadingKey = HeadingKey(mission);
                var result = await moonModule.InvokeAsync<LandingResult>("playLanding", options, landingHud);
                status = result.Status;
                Console.WriteLine($"[Landing] {result.Status} · model: {result.Model ?? "schematic"}");
                if (result.Simplified) Console.WriteLine($"[Landing] low frame rate ({result.Fps:0} fps) — simplified model");
            }
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Landing] animation failed: {ex.Message}");
        }
        finally
        {
            Ui.NotifyLandingFinished(status);
        }
    }

    /// <summary>The landed model stays until the site or the lander changes; a change mid-descent cancels it.</summary>
    private async Task SyncLandingMarkerAsync()
    {
        if (landedKey is null || moonModule is null) return;
        var key = $"{MissionState.SelectedSite?.Id}|{MissionState.SelectedLander?.Id}";
        if (key == landedKey) return;
        landedKey = null;
        try { await moonModule.InvokeVoidAsync("clearLandingMarker"); }
        catch (JSDisconnectedException) { }
        Ui.ClearContact();
    }

    private void HandleAnalysisChanged() => _ = InvokeAsync(async () =>
    {
        if (MissionState.SelectedSite is { } s) await SyncSunLightAsync(s);
        await SyncLanderHeadingAsync();
        StateHasChanged();
    });

    // ---- Lander heading in 3D = the analysed mission's heading (AUTO or manual) ----
    private int landingMissionVersion = int.MaxValue;   // missions newer than this belong to the current landing
    private string? lastHeadingKey;

    /// <summary>The mission at this site computed after the current landing started (null if none yet).</summary>
    private SimulationResult? FreshMission(string siteId) =>
        Analysis.MissionVersion > landingMissionVersion && Analysis.MissionSiteId == siteId ? Analysis.Mission : null;

    private static string HeadingKey(SimulationResult m) =>
        m.FixedPanels && m.HeadingDeg is { } h ? $"{h:0.#}|{m.HeadingAuto}" : "none";

    /// <summary>Turn the descending or landed lander to the newest mission's heading (in flight: terminal yaw).</summary>
    private async Task SyncLanderHeadingAsync()
    {
        if (landedKey is null || moonModule is null || MissionState.SelectedSite is not { } site) return;
        if (FreshMission(site.Id) is not { } mission) return;
        var key = HeadingKey(mission);
        if (key == lastHeadingKey) return;
        lastHeadingKey = key;
        try
        {
            await moonModule.InvokeVoidAsync("setLanderHeading",
                mission.FixedPanels ? mission.HeadingDeg : null, mission.HeadingAuto, Ui.ReducedMotion);
        }
        catch (JSDisconnectedException) { }
    }

    private void HandleUiChanged() => _ = InvokeAsync(async () => { await SyncCandidatesAsync(); await SyncViewerFlagsAsync(); StateHasChanged(); });

    private ElementReference replayHud;

    private void HandleCustomChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Start (true) or stop and reset (false) the mission replay in the viewer.</summary>
    private void HandleReplayRequested(bool play) => _ = InvokeAsync(async () =>
    {
        if (moonModule is null) { if (play) Ui.ReplayEnded(Ui.OutcomeOf()); return; }
        try
        {
            if (!play) { await moonModule.InvokeVoidAsync("stopReplay"); return; }
            var payload = await ReplayPayloadAsync();
            if (payload is null) { Ui.ReplayEnded(Ui.OutcomeOf()); return; }
            await moonModule.InvokeVoidAsync("playReplay", payload, replayHud);
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Replay] {ex.Message}");
            Ui.ReplayEnded(Ui.OutcomeOf());
        }
    });

    /// <summary>Hourly mission data for the replay: Sun direction from illumination, battery and contact from the simulation.</summary>
    private async Task<object?> ReplayPayloadAsync()
    {
        if (Analysis.Mission is not { } m || MissionState.SelectedSite is not { } site || MissionState.SelectedLander is not { } lander) return null;
        var series = await Repo.GetSeries(site.Id);
        var start = series.IndexOf(m.LandingUtc);
        if (start < 0 || !series.HasSunGeometry) return null;
        var n = new[] { m.Steps, m.Sun.Length, m.Earth.Length, m.SocPct.Length, series.Count - start }.Min();
        if (n < 2) return null;
        return new
        {
            startUtc = m.LandingUtc.ToString("yyyy-MM-ddTHH:mm:ssZ", System.Globalization.CultureInfo.InvariantCulture),
            stepHours = m.StepHours,
            lat = site.Lat, lon = site.Lon,
            sunAz = Enumerable.Range(start, n).Select(i => series.SunAzCentiDeg[i] / 100.0).ToArray(),
            sunEl = Enumerable.Range(start, n).Select(i => series.SunElevCentiDeg[i] / 100.0).ToArray(),
            earthAz = series.EarthAzCentiDeg.Length >= start + n ? Enumerable.Range(start, n).Select(i => series.EarthAzCentiDeg[i] / 100.0).ToArray() : [],
            earthEl = series.EarthElevCentiDeg.Length >= start + n ? Enumerable.Range(start, n).Select(i => series.EarthElevCentiDeg[i] / 100.0).ToArray() : [],
            sunPct = m.Sun.Take(n).ToArray(),
            earth = m.Earth.Take(n).ToArray(),
            soc = m.SocPct.Take(n).Select(v => Math.Round(v, 1)).ToArray(),
            depletedAt = m.DepletedAtStep ?? -1,
            outcome = Ui.OutcomeOf(),
            landerName = lander.Name, siteName = site.Name,
            sizeM = lander.Model?.SizeM ?? 4,
            nozzleOffset = lander.Model?.NozzleOffset,
            reason = m.Reason,
        };
    }

    [JSInvokable] public void OnReplayStep(int step) => Ui.SetReplayStep(step);

    [JSInvokable] public void OnReplayEnded(string outcome) => Ui.ReplayEnded(outcome);

    /// <summary>Panel site list → light up that pin on the globe (name shown, pin grows).</summary>
    private void HandleSiteHover(string? siteId) => _ = InvokeAsync(async () =>
    {
        if (!moonLoaded || moonModule is null) return;
        try { await moonModule.InvokeVoidAsync("highlightSite", siteId); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    });

    /// <summary>The user dragged / scrolled the camera or pressed Esc: the mission summary folds away.</summary>
    [JSInvokable] public void OnViewerInteraction() => Ui.CollapseSummary();

    private bool terrain3D;
    private bool surfaceView;

    [JSInvokable] public void OnSurfaceViewChanged(bool on) { surfaceView = on; StateHasChanged(); }

    private async Task ToggleSurfaceViewAsync()
    {
        Ui.CollapseSummary();
        if (moonModule is null || MissionState.SelectedSite is not { } site) return;
        try
        {
            if (surfaceView)
            {
                await moonModule.InvokeVoidAsync("exitSurfaceView");
                await ZoomToSiteAsync();
            }
            else
            {
                await SyncSunLightAsync(site);
                await moonModule.InvokeAsync<bool>("enterSurfaceView", site.Lat, site.Lon, Ui.ReplayPlaying);
            }
        }
        catch (JSDisconnectedException) { }
    }

    private const string CandidatesTip = "Show the evaluated candidate sites";
    private const string PsrTip = "Show craters in permanent shadow near this site, where water ice can be trapped";
    private bool psrOn;
    private string? psrShownFor;

    private async Task TogglePsrAsync()
    {
        Ui.CollapseSummary();
        psrOn = !psrOn;
        await SyncPsrAsync();
    }

    /// <summary>Show / hide the PSR outlines (data/science/psr.json) around the selected region's site.</summary>
    private async Task SyncPsrAsync()
    {
        if (!moonLoaded || moonModule is null) return;
        var site = psrOn && HasRegionSelected ? MissionState.Psr?.SiteFor(MissionState.SelectedSite!.Id) : null;
        if (site?.SiteId == psrShownFor) return;
        psrShownFor = site?.SiteId;
        try
        {
            if (site is null) await moonModule.InvokeVoidAsync("clearPsr");
            else await moonModule.InvokeVoidAsync("showPsr", site.Outlines);
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { Console.Error.WriteLine($"[MoonPanel] PSR layer: {ex.Message}"); }
    }
    private string? hudTip;
    private void ShowTip(string text) => hudTip = text;
    private void HideTip() => hudTip = null;

    private void ToggleSettings()
    {
        Ui.CollapseSummary();
        settingsOpen = !settingsOpen;
    }

    private void ToggleCandidates()
    {
        Ui.CollapseSummary();
        Ui.ToggleCandidates();
    }

    /// <summary>
    /// NEW LANDING: remove the landed model and give the camera back. It flies out to the south-pole overview
    /// (as ⌂ View): left at the landed close-up a few metres over an empty spot, it showed a dark texture
    /// with no context while the user picks the next site.
    /// </summary>
    private void HandleNewLanding() => _ = InvokeAsync(async () =>
    {
        landedKey = null;
        if (moonModule is null) return;
        try
        {
            await moonModule.InvokeVoidAsync("clearLandingMarker");
            await moonModule.InvokeVoidAsync("resetView", true);
        }
        catch (JSDisconnectedException) { }
    });

    private (bool Locked, bool Enhance)? sentFlags;

    /// <summary>LANDED locks site picking on the Moon; ENHANCE brightens the scene. Sent only when they change.</summary>
    private async Task SyncViewerFlagsAsync()
    {
        if (!moonLoaded || moonModule is null) return;
        var flags = (Ui.Landed, Ui.EnhanceView);
        if (sentFlags == flags) return;
        sentFlags = flags;
        try { await moonModule.InvokeVoidAsync("setViewerFlags", flags.Item1, flags.Item2); }
        catch (JSDisconnectedException) { }
    }

    private void HandleIntro()
    {
        if (!moonLoaded || moonModule is null) { introPending = true; return; }
        _ = moonModule.InvokeVoidAsync("introFlight").AsTask();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            // Cesium is loaded with `defer` so it downloads alongside the .NET runtime.
            if (!await Ui.WhenCesiumReadyAsync())
            {
                throw new InvalidOperationException("the 3D engine (CesiumJS) could not be downloaded — check the connection and reload");
            }
            moonModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/moonViewer.js");
            dotNetRef = DotNetObjectReference.Create(this);

            var token = Config["CesiumIonToken"] ?? "";
            var result = await moonModule.InvokeAsync<InitResult>("initViewer", "moon-viewer-element", token, dotNetRef);

            terrain3D = result.TerrainLoaded;
            if (!result.TerrainLoaded)
            {
                // 2D is a supported mode, not a failure: show it as a mode label.
                badgeText = "2D MOSAIC MODE";
                badgeTitle = result.HasToken
                    ? "NASA/JPL Moon Trek LRO WAC mosaic on a smooth Moon (3D terrain asset not available for this token)"
                    : "NASA/JPL Moon Trek LRO WAC mosaic on a smooth Moon";
            }

            moonLoaded = true;
            await SyncViewerFlagsAsync();
            Ui.SetViewerReady(result.TerrainLoaded);
            await SyncViewerAsync();
            if (introPending)
            {
                introPending = false;
                await moonModule.InvokeVoidAsync("introFlight");
            }
            Ui.SetTilesLoaded(await moonModule.InvokeAsync<bool>("waitForTiles", 2400));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[MoonPanel] Viewer initialization failed: {ex}");
            initError = ex.Message;
        }

        StateHasChanged();
    }

    private void HandleStateChanged()
    {
        _ = SyncViewerAsync();
        _ = InvokeAsync(SyncCandidatesAsync);
        _ = InvokeAsync(SyncPsrAsync);
        _ = InvokeAsync(SyncLandingMarkerAsync);
        _ = InvokeAsync(StateHasChanged); // keeps HUD button state in sync with the selection
    }

    private async Task SouthPoleViewAsync()
    {
        Ui.CollapseSummary();
        if (moonModule is null) return;
        try
        {
            await moonModule.InvokeVoidAsync("resetView", true);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task ZoomToSiteAsync()
    {
        Ui.CollapseSummary();
        var site = MissionState.SelectedSite;
        if (site is null) return Task.CompletedTask;
        // A user-clicked custom site lives in the viewer under a fixed entity id.
        var entityId = site.Id.StartsWith("CUSTOM", StringComparison.Ordinal) ? "custom-site" : site.Id;
        return FlyToAsync(entityId);
    }

    private async Task SyncViewerAsync()
    {
        if (!moonLoaded || moonModule is null) return;

        try
        {
            StartModelPreload();

            // Sites may arrive after the viewer started; only re-send when the list actually changed.
            if (!ReferenceEquals(loadedSites, MissionState.AvailableSites))
            {
                loadedSites = MissionState.AvailableSites;
                await moonModule.InvokeVoidAsync("loadSites", loadedSites);
            }

            var selected = MissionState.SelectedSite;
            if (selected is not null && !selected.Id.StartsWith("CUSTOM", StringComparison.Ordinal))
            {
                await moonModule.InvokeVoidAsync("selectSite", selected.Id);
                var model = MissionState.SelectedLander?.Model;
                var prefetchKey = $"{selected.Id}|{model?.Uri}";
                if (Ui.LandingAnimationEnabled && prefetchedFor != prefetchKey)
                {
                    prefetchedFor = prefetchKey;
                    _ = moonModule.InvokeVoidAsync("prefetchLanding", selected.Lat, selected.Lon, model).AsTask();
                }
                await SyncSunLightAsync(selected);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[MoonPanel] Failed to sync sites: {ex}");
        }
    }

    /// <summary>Show / hide the evaluated candidate sites of the selected region.</summary>
    private async Task SyncCandidatesAsync()
    {
        if (!moonLoaded || moonModule is null) return;
        var want = Ui.CandidatesOn && HasRegionSelected ? MissionState.SelectedSite!.Id : null;
        if (want == candidatesShownFor) return;
        candidatesShownFor = want;
        candidateError = null;
        try
        {
            if (want is null)
            {
                await moonModule.InvokeVoidAsync("clearCandidates");
                return;
            }
            var file = await Http.GetFromJsonAsync<CandidateFile>($"data/illumination/candidates/{Uri.EscapeDataString(want)}.json",
                new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            var points = (file?.Candidates ?? []).Select(c => new
            {
                id = c.CandidateId,
                lat = c.Lat,
                lon = c.Lon,
                sunPct = c.SunPct,
                rejected = c.Rejected,
                label = c.Rejected
                    ? $"{c.CandidateId} · rejected: {c.Reason}"
                    : $"{c.CandidateId} · lit {c.SunPct:0}% · Earth {c.EarthPct:0}%",
            }).ToList();
            candidateCount = points.Count;
            await moonModule.InvokeVoidAsync("showCandidates", points);
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[MoonPanel] candidates: {ex.Message}");
            candidateError = "candidate sites unavailable for this region";
        }
        StateHasChanged();
    }

    /// <summary>
    /// Scene light from the precomputed Sun position for the selected site at the same moment the
    /// compass shows (timeline hover → mission landing time → first data hour).
    /// </summary>
    private async Task SyncSunLightAsync(Site site)
    {
        var analysedCustom = site.IsCustom && Analysis.MissionSiteId == site.Id;
        if (moonModule is null || (!analysedCustom && !MissionState.AvailableSites.Any(s => s.Id == site.Id))) return;
        try
        {
            var series = await Repo.GetSeries(site.Id);
            var moment = Ui.HoverTimeUtc
                         ?? (Analysis.MissionSiteId == site.Id ? Analysis.Mission?.LandingUtc : null)
                         ?? series.Start;
            var i = series.IndexOf(moment);
            if (i < 0) return;
            var hasEarth = series.EarthAzCentiDeg.Length > i && series.EarthElevCentiDeg.Length > i;
            await moonModule.InvokeVoidAsync("setSunLight", site.Lat, site.Lon,
                series.SunAzCentiDeg[i] / 100.0, series.SunElevCentiDeg[i] / 100.0, series.SunFraction[i],
                hasEarth ? series.EarthAzCentiDeg[i] / 100.0 : (double?)null, hasEarth ? series.EarthElevCentiDeg[i] / 100.0 : (double?)null);
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[MoonPanel] sun light: {ex.Message}");
        }
    }

    private void HandleHoverTime()
    {
        if (MissionState.SelectedSite is { } s) _ = InvokeAsync(() => SyncSunLightAsync(s));
    }

    private void HandleFlyToRequested(string siteId) => _ = FlyToAsync(siteId);

    private async Task FlyToAsync(string siteId)
    {
        if (!moonLoaded || moonModule is null) return;

        try
        {
            await moonModule.InvokeVoidAsync("flyToSite", siteId);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[MoonPanel] Fly-to failed: {ex}");
        }
    }

    /// <summary>
    /// Once per session: preload every lander model in the background (QUICK DEMO lander first, then the
    /// selected one, then the rest), a few seconds after start so it does not slow the first view.
    /// </summary>
    private void StartModelPreload()
    {
        if (modelPreloadStarted || moonModule is null || !Ui.LandingAnimationEnabled || MissionState.AllLanders.Count == 0) return;
        modelPreloadStarted = true;
        var models = MissionState.AllLanders
            .OrderBy(l => l.Id == UiService.RecommendedLanderId ? 0 : l.Id == MissionState.SelectedLander?.Id ? 1 : 2)
            .Select(l => l.Model).OfType<LanderModelSpec>().ToList();
        _ = moonModule.InvokeVoidAsync("preloadModels", models, 3000).AsTask();
    }

    /// <summary>Load state of a lander model ("loading", "ready", "failed"), shown in the viewer HUD.</summary>
    [JSInvokable]
    public Task OnModelStatus(string uri, string status)
    {
        if (modelStatus.TryGetValue(uri, out var old) && old == status) return Task.CompletedTask;
        modelStatus[uri] = status;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSiteSelected(string siteId)
    {
        Ui.ConfirmSite();
        return MissionState.SelectSite(siteId);
    }

    [JSInvokable]
    public async Task OnCustomSiteCreated(double lat, double lon)
    {
        Ui.ConfirmSite();
        var customSite = new Site
        {
            Id = "CUSTOM_" + DateTime.UtcNow.Ticks,
            Name = CustomName(lat, lon),
            Lat = lat,
            Lon = lon,
            Approximate = true,
            Source = "USER_INPUT"
        };
        await MissionState.SelectSite(customSite.Id, customSite);
        Ui.SetOpenStep(1);
        // Slope and coverage from the 240 m DEM (downloaded on the first click, then cached).
        var point = await Custom.DescribeAsync(lat, lon);
        customSite.CustomChecked = true;
        customSite.SlopeDeg = double.IsFinite(point.SlopeDeg) ? Math.Round(point.SlopeDeg, 1) : null;
        customSite.CustomUnavailable = point.Error
            ?? (point.InCoverage ? null : "Custom analysis covers the south polar region (80–90°S)");
        MissionState.NotifySiteChanged();
    }

    private static string CustomName(double lat, double lon) => string.Create(System.Globalization.CultureInfo.InvariantCulture,
        $"Custom {Math.Abs(lat):F2}°{(lat < 0 ? "S" : "N")} {Math.Abs(lon):F2}°{(lon < 0 ? "W" : "E")}");

    public async ValueTask DisposeAsync()
    {
        MissionState.OnStateChanged -= HandleStateChanged;
        MissionState.OnFlyToRequested -= HandleFlyToRequested;
        Analysis.OnChanged -= HandleAnalysisChanged;
        Ui.OnChanged -= HandleUiChanged;
        Ui.IntroRequested -= HandleIntro;
        Ui.LandingRequested -= HandleLandingRequested;
        Ui.NewLandingRequested -= HandleNewLanding;
        Ui.ReplayRequested -= HandleReplayRequested;
        Ui.SiteHoverChanged -= HandleSiteHover;
        Custom.OnChanged -= HandleCustomChanged;
        Ui.HoverTimeChanged -= HandleHoverTime;

        if (moonModule is not null)
        {
            try
            {
                await moonModule.InvokeVoidAsync("dispose");
                await moonModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        dotNetRef?.Dispose();
    }
}

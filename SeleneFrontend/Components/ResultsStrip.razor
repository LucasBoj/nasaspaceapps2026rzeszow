@using SeleneFrontend.Models
@using SeleneFrontend.Services
@implements IDisposable
@inject AnalysisService Analysis
@inject MissionConfigState MissionState
@inject UiService Ui
@inject IJSRuntime JS

<div class="results-strip @(expanded ? "expanded" : "")" id="results-strip">
    @* Drag (or arrow keys) to trade Moon height for analysis height; the page scrolls when both do not fit. *@
    <div class="results-resize" role="separator" aria-orientation="horizontal" aria-label="Moon view height (arrow keys resize the analysis panel)"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0" @ref="handle"></div>
    <div class="results-head-row">
    <button type="button" class="results-header" aria-expanded="@(expanded ? "true" : "false")" aria-controls="results-content"
            @onclick="ToggleAsync">
        <span class="toggle-icon" aria-hidden="true">@(expanded ? "▼" : "▶")</span>
        <span class="results-title">Analysis details</span>
        @if (Ui.LandingInProgress)
        {
            <span class="results-status">waiting for touchdown…</span>
        }
        else if (Analysis.IsRunning)
        {
            <span class="results-status">analyzing all 9 sites… <span class="num">@((int)(Analysis.Progress * 100))%</span></span>
        }
        else if (Analysis.Mission is not null)
        {
            <span class="results-status results-summary">@Analysis.MissionSiteName · timeline, landing-window heatmap, comparison</span>
        }
        else if (!MissionState.IsLoaded)
        {
            <span class="skeleton-inline" style="width: 220px"></span>
        }
        else
        {
            <span class="results-status">choose a site and a lander, then Land &amp; analyze</span>
        }
        @if (Analysis.IsOutdated)
        {
            <span class="outdated-badge">Results are out of date — settings changed</span>
        }
    </button>
    <span class="results-size-btns">
        <button type="button" class="hud-btn small" @onclick="ExpandAsync" disabled="@(!Analysis.HasResults)"
                aria-describedby="@(Analysis.HasResults ? null : "expand-reason")">Expand</button>
        <button type="button" class="hud-btn small" @onclick="CollapseAsync" disabled="@(!expanded)">Collapse</button>
        @if (!Analysis.HasResults)
        {
            <span class="reason" id="expand-reason">nothing to show yet</span>
        }
    </span>
    </div>

    <div class="results-content" id="results-content" hidden="@(!expanded)">
        @if (expanded)
        {
            @if (Analysis.Error is { } err)
            {
                <p class="results-error" role="alert">Analysis failed: @err</p>
            }

            @if (Ui.LandingInProgress)
            {
                <div class="skeleton-block" style="height: 26px; width: 60%"></div>
            }
            else if (Analysis.Mission is { } mission)
            {
                <VerdictCard Inline="true" />
                <div class="results-toolbar">
                    <p class="verdict-reason">
                        <span class="num">@Analysis.MissionSiteName · @mission.LandingUtc.ToString("yyyy-MM-dd") · @mission.DurationDays.ToString("0.#") d</span> —
                        @mission.Reason. <Term Key="soc">Battery</Term> · <Term Key="earth">Earth comms</Term> · <Term Key="verdict">Verdict</Term>
                        · lander data: <KindBadge Kind="@mission.BasedOn" />
                    </p>
                    <div class="results-tabs" role="tablist" aria-label="Result views">
                        <button type="button" role="tab" class="results-tab @(Ui.ResultsTab == "mission" ? "active" : "")"
                                aria-selected="@(Ui.ResultsTab == "mission" ? "true" : "false")" @onclick="@(() => Ui.SetResultsTab("mission"))">MISSION</button>
                        <button type="button" role="tab" class="results-tab @(Ui.ResultsTab == "compare" ? "active" : "")"
                                aria-selected="@(Ui.ResultsTab == "compare" ? "true" : "false")" @onclick="@(() => Ui.SetResultsTab("compare"))">COMPARE</button>
                    </div>
                </div>

                @if (Ui.ResultsTab == "compare")
                {
                    <CompareView />
                }
                else
                {
                    <RobustnessRow Load="Analysis.LoadSensitivity" Nasa="MissionState.NasaCheckFor(Analysis.MissionSiteId)" />
                    <PowerCommsTiles M="mission" MaxStayDays="Analysis.MaxSurvivableDays" />
                    <div class="results-grid">
                        <section class="results-panel" aria-label="Mission timeline" id="results-timeline">
                            <h3>MISSION TIMELINE · @mission.DurationDays.ToString("0.#") d</h3>
                            <MissionTimeline Result="mission" ThresholdPct="Analysis.ThresholdBatteryPct" OnHoverTime="Ui.SetHoverTime" />
                        </section>
                        <section class="results-panel" aria-label="Landing window heatmap" id="results-heatmap">
                            @if (Analysis.Heatmap is { } heatmap)
                            {
                                <div class="panel-head">
                                    <h3>LANDING WINDOW · @heatmap.Sites.Count REGIONS × @heatmap.Days DAYS@(heatmap.Days > 366 ? " · one column per week (best day)" : "") · <Term Key="score">score</Term></h3>
                                    <button type="button" class="hud-btn small" @onclick="@(() => Ui.SetResultsTab("compare"))">COMPARE ▸</button>
                                </div>
                                <LandingHeatmap Result="heatmap" Selected="Analysis.SelectedCell" OnCellClick="OnCellClick" Pulse="PulseToken()" />
                                <div class="best-dates" role="group" aria-label="Best landing day per region">
                                    @for (var s = 0; s < heatmap.Sites.Count; s++)
                                    {
                                        var site = s;
                                        var day = heatmap.BestDayFor(s);
                                        if (day < 0)
                                        {
                                            <span class="best-date none">@heatmap.Sites[s].Name: none feasible</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="best-date" @onclick="() => OnCellClick((site, day))">
                                                @heatmap.Sites[s].Name · @heatmap.DayUtc(day).ToString("MM-dd") · @heatmap.Scores[s, day].ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)
                                            </button>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <h3>LANDING WINDOW · computing all regions… @((int)(Analysis.Progress * 100))%</h3>
                                <div class="skeleton-block" style="height: 150px"></div>
                                <div class="skeleton-block" style="height: 18px; margin-top: 8px; width: 70%"></div>
                            }
                        </section>
                    </div>
                }
            }
            else if (Analysis.IsRunning || !MissionState.IsLoaded)
            {
                <div class="skeleton-block" style="height: 26px; width: 60%"></div>
                <div class="results-grid" style="margin-top: 12px">
                    <div class="skeleton-block" style="height: 170px"></div>
                    <div class="skeleton-block" style="height: 170px"></div>
                </div>
            }
            else if (Analysis.Error is null)
            {
                <p class="results-hint">Select one of the 9 regions and a lander, then press <strong>RUN ANALYSIS</strong>.
                    Every landing day in the window is simulated for all regions.</p>
            }
        }
    </div>
</div>

@code {
    private bool expanded;
    private int seenExpand;
    private int pulseConsumed;

    /// <summary>Hand the heatmap a pulse token only once per request (re-created canvases must not pulse again).</summary>
    private int PulseToken()
    {
        var token = Analysis.HighlightBestToken;
        if (token == pulseConsumed) return 0;
        pulseConsumed = token;
        return token;
    }

    private Task OnCellClick((int Site, int Day) cell) => Analysis.SelectCellAsync(cell.Site, cell.Day);

    private ElementReference handle;
    private IJSObjectReference? ui;
    private bool fitPending = true;

    private async Task<IJSObjectReference> UiJs() => ui ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");

    private async Task ToggleAsync()
    {
        if (expanded) await CollapseAsync(); else await ExpandAsync();
    }

    /// <summary>Open to the full height the timeline and heatmap need (the Moon gives way; the page scrolls if needed).</summary>
    private async Task ExpandAsync()
    {
        expanded = true;
        fitPending = true;
        StateHasChanged();
        await Task.Yield();
        try { await (await UiJs()).InvokeVoidAsync("fitResults", true); } catch (JSDisconnectedException) { }
    }

    private async Task CollapseAsync()
    {
        expanded = false;
        try { await (await UiJs()).InvokeVoidAsync("resetMoonHeight"); } catch (JSDisconnectedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender) await (await UiJs()).InvokeVoidAsync("attachResultsResize", handle);
            if (expanded && fitPending && Analysis.HasResults)
            {
                fitPending = false;
                await (await UiJs()).InvokeVoidAsync("fitResults", false);
            }
        }
        catch (JSDisconnectedException) { }
    }

    protected override void OnInitialized()
    {
        pulseConsumed = Analysis.HighlightBestToken;
        // Created when Analyst mode turns on: open straight away if there is something to show.
        seenExpand = Analysis.ExpandToken;
        expanded = Analysis.HasResults || Analysis.IsRunning;
        Analysis.OnChanged += HandleChanged;
        MissionState.OnStateChanged += Refresh;   // outdated badge
        Ui.OnChanged += Refresh;                   // tabs
    }

    private void HandleChanged()
    {
        if (Analysis.ExpandToken != seenExpand)
        {
            seenExpand = Analysis.ExpandToken;
            expanded = true;
            fitPending = true;
        }
        if (Analysis.Error is not null) expanded = true;
        InvokeAsync(StateHasChanged);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Analysis.OnChanged -= HandleChanged;
        MissionState.OnStateChanged -= Refresh;
        Ui.OnChanged -= Refresh;
    }
}

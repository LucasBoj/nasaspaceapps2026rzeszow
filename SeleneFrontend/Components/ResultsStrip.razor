@using SeleneFrontend.Models
@using SeleneFrontend.Services
@implements IDisposable
@inject AnalysisService Analysis
@inject MissionConfigState MissionState

<div class="results-strip @(expanded ? "expanded" : "")">
    <button type="button" class="results-header" aria-expanded="@(expanded ? "true" : "false")" aria-controls="results-content"
            @onclick="() => expanded = !expanded">
        <span class="toggle-icon" aria-hidden="true">@(expanded ? "▼" : "▶")</span>
        @if (Analysis.Mission is { } m)
        {
            <span class="results-title">RESULTS —</span>
            <span class="results-summary @VerdictClass(m.Verdict)">@VerdictLabel(m.Verdict)</span>
            <span class="results-title">@Analysis.MissionSiteName · land @m.LandingUtc.ToString("yyyy-MM-dd")</span>
        }
        else
        {
            <span class="results-title">RESULTS — select a site and a lander, then RUN ANALYSIS</span>
        }
        @if (Analysis.IsOutdated)
        {
            <span class="outdated-badge">RESULTS OUTDATED — re-run</span>
        }
    </button>

    @if (expanded)
    {
        <div class="results-content" id="results-content">
            @if (Analysis.Error is { } err)
            {
                <p class="results-error" role="alert">Analysis failed: @err</p>
            }

            @if (Analysis.Mission is { } mission && Analysis.Heatmap is { } heatmap)
            {
                <div class="verdict-line @VerdictClass(mission.Verdict)" role="status">
                    @VerdictLabel(mission.Verdict) — @Analysis.MissionSiteName · land @mission.LandingUtc.ToString("yyyy-MM-dd")
                    · min battery @mission.MinSocPct.ToString("0")% · Earth comms @mission.CommsPct.ToString("0")%
                    · based on: @ParamKind.Label(mission.BasedOn)
                </div>
                <p class="verdict-reason">@Capitalize(mission.Reason).</p>

                <div class="results-grid">
                    <section class="results-panel" aria-label="Mission timeline">
                        <h3>MISSION TIMELINE · @mission.DurationDays.ToString("0.#") d</h3>
                        <MissionTimeline Result="mission" ThresholdPct="Analysis.ThresholdBatteryPct" />
                    </section>
                    <section class="results-panel" aria-label="Landing window heatmap">
                        <h3>LANDING WINDOW · @heatmap.Sites.Count REGIONS × @heatmap.Days DAYS</h3>
                        <LandingHeatmap Result="heatmap" Selected="Analysis.SelectedCell" OnCellClick="OnCellClick" />
                        <div class="best-dates" role="group" aria-label="Best landing day per region">
                            @for (var s = 0; s < heatmap.Sites.Count; s++)
                            {
                                var site = s;
                                var day = heatmap.BestDayFor(s);
                                if (day < 0)
                                {
                                    <span class="best-date none">@heatmap.Sites[s].Name: none feasible</span>
                                }
                                else
                                {
                                    <button type="button" class="best-date" @onclick="() => OnCellClick((site, day))">
                                        @heatmap.Sites[s].Name · @heatmap.DayUtc(day).ToString("MM-dd") · @heatmap.Scores[s, day].ToString("0")
                                    </button>
                                }
                            }
                        </div>
                    </section>
                </div>
            }
            else if (!Analysis.IsRunning && Analysis.Error is null)
            {
                <p class="results-hint">Select one of the 9 regions and a lander, then press <strong>RUN ANALYSIS</strong>.
                    Every landing day in the window is simulated for all regions.</p>
            }
        </div>
    }
</div>

@code {
    private bool expanded;
    private int seenRun;

    private static string VerdictLabel(Verdict v) => v switch
    {
        Verdict.Feasible => "FEASIBLE",
        Verdict.Marginal => "MARGINAL",
        _ => "NOT FEASIBLE",
    };

    private static string VerdictClass(Verdict v) => v switch
    {
        Verdict.Feasible => "v-feasible",
        Verdict.Marginal => "v-marginal",
        _ => "v-nogo",
    };

    private static string Capitalize(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];

    private Task OnCellClick((int Site, int Day) cell) => Analysis.SelectCellAsync(cell.Site, cell.Day);

    protected override void OnInitialized()
    {
        Analysis.OnChanged += HandleChanged;
        MissionState.OnStateChanged += HandleConfigChanged;   // outdated badge
    }

    private void HandleConfigChanged() => InvokeAsync(StateHasChanged);

    private void HandleChanged()
    {
        // Auto-expand once per finished analysis.
        if (Analysis.RunCount != seenRun && !Analysis.IsRunning)
        {
            seenRun = Analysis.RunCount;
            expanded = true;
        }
        if (Analysis.Error is not null) expanded = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Analysis.OnChanged -= HandleChanged;
        MissionState.OnStateChanged -= HandleConfigChanged;
    }
}

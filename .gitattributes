# Files that run or are read on Linux (CI runner, the Mikrus server) keep LF line endings,
# also in Windows checkouts with core.autocrlf=true (bash rejects CRLF: $'\r': command not found).
*.sh   text eol=lf
*.conf text eol=lf
*.yml  text eol=lf

# Vendored third-party builds (CesiumJS): keep the files byte-identical, hide them from language stats.
SeleneFrontend/wwwroot/lib/** -text linguist-vendored

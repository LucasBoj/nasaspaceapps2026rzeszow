@page "/"
@using SeleneFrontend.Components
@using SeleneFrontend.Services

<PageTitle>SELENE OPS · Lunar Landing Window Planner</PageTitle>

<CascadingValue Value="missionState">
    <div class="app-container">
        <TopBar />
        <div class="main-content">
            <div class="moon-panel">
                <MoonPanel @ref="moonPanel" />
            </div>
            <div class="splitter" title="Drag to resize"></div>
            <div class="config-panel">
                <ConfigPanel />
            </div>
        </div>
        <ResultsStrip />
    </div>
</CascadingValue>

@code {
    [Inject]
    private MissionConfigState missionState { get; set; } = null!;

    private MoonPanel? moonPanel;

    protected override async Task OnInitializedAsync()
    {
        await missionState.LoadData();
    }
}
